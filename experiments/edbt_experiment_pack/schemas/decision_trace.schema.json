{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision Trace CSV Row",
  "type": "object",
  "required": [
    "run_id", "config", "rep", "unix_ts_ns", "cycle_id", "phase",
    "table_name", "chunk_id", "column_id", "segment_bytes",
    "source_tier", "target_tier", "action", "selected", "rank", "fits_remaining",
    "policy", "data_type", "bytes_per_value", "total_score",
    "access_rate_raw", "max_rate", "norm_freq", "access_type", "atype_score",
    "data_volume_bytes", "max_volume_bytes", "norm_volume", "is_immutable",
    "immutable_score", "weight_atype", "weight_freq", "weight_volume",
    "weight_immutable", "term_atype", "term_freq", "term_volume",
    "term_immutable", "estimated_cardinality", "operator_mask",
    "remaining_budget_before", "remaining_budget_after"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "config": {"enum": ["our_full", "our_freq", "cost_c3_greedy"]},
    "rep": {"type": "integer", "minimum": 1},
    "unix_ts_ns": {"type": "integer", "minimum": 0},
    "cycle_id": {"type": "integer", "minimum": 0},
    "phase": {"enum": ["warmup", "timed_first_half", "timed_second_half"]},
    "table_name": {"type": "string"},
    "chunk_id": {"type": "integer", "minimum": 0},
    "column_id": {"type": "integer", "minimum": 0},
    "segment_bytes": {"type": "integer", "minimum": 0},
    "source_tier": {"enum": ["DRAM", "CXL", "UNKNOWN"]},
    "target_tier": {"enum": ["DRAM", "CXL", "UNCHANGED"]},
    "action": {"enum": ["promote", "demote", "keep", "skip_no_fit", "skip_other"]},
    "selected": {"type": "boolean"},
    "rank": {"type": "integer", "minimum": 0},
    "fits_remaining": {"type": "boolean"},
    "policy": {"enum": ["our_full", "our_no_plan", "cost_c3_greedy"]},
    "data_type": {"type": "string", "minLength": 1},
    "bytes_per_value": {"type": "number", "exclusiveMinimum": 0},
    "total_score": {"type": "number"},
    "access_rate_raw": {"type": "number", "minimum": 0},
    "max_rate": {"type": "number", "minimum": 0},
    "norm_freq": {"type": "number", "minimum": 0},
    "access_type": {"enum": ["Scan", "PointLookup", "HashBuild", "HashProbe", "Aggregate", "Sort", "Unknown"]},
    "atype_score": {"type": "number"},
    "data_volume_bytes": {"type": "integer", "minimum": 0},
    "max_volume_bytes": {"type": "integer", "minimum": 0},
    "norm_volume": {"type": "number"},
    "is_immutable": {"type": "boolean"},
    "immutable_score": {"type": "number"},
    "weight_atype": {"type": "number"},
    "weight_freq": {"type": "number"},
    "weight_volume": {"type": "number"},
    "weight_immutable": {"type": "number"},
    "term_atype": {"type": "number"},
    "term_freq": {"type": "number"},
    "term_volume": {"type": "number"},
    "term_immutable": {"type": "number"},
    "estimated_cardinality": {"type": "number"},
    "operator_mask": {"type": "string"},
    "remaining_budget_before": {"type": "integer", "minimum": 0},
    "remaining_budget_after": {"type": "integer", "minimum": 0},
    "sequential_count": {"type": ["integer", "null"], "minimum": 0},
    "monotonic_count": {"type": ["integer", "null"], "minimum": 0},
    "random_count": {"type": ["integer", "null"], "minimum": 0},
    "point_count": {"type": ["integer", "null"], "minimum": 0},
    "dictionary_count": {"type": ["integer", "null"], "minimum": 0},
    "dictionary_handling": {"type": ["string", "null"]},
    "cost_dram": {"type": ["number", "null"]},
    "cost_cxl": {"type": ["number", "null"]}
  },
  "additionalProperties": true
}
