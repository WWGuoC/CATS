--- /dev/null
+++ b/experiments/edbt_v4/analyze_calibration_sensitivity.py
@@ -0,0 +1,242 @@
+#!/usr/bin/env python3
+"""EDBT v4 Phase B2 (B2-7 + B2-8): calibration & Dictionary placement sensitivity.
+
+Inputs:
+  --trace <decision_trace.csv>   a cost_c3_greedy trace-on bundle's decision trace
+                                 (carries per-cycle raw 5-pattern counters, dtype,
+                                 bpv, data_volume_bytes)
+  --stats <calibration_stats.csv> aggregate_calibration_v2.py output
+  --cycle last|<n>               which daemon cycle's cumulative counters to use
+                                 as the workload snapshot (default: last)
+
+Analyses:
+  B2-7  placement under median calibration vs UNCERTAINTY ENDPOINTS
+        (all cells at ci95_low / all at ci95_high). Benefit recomputed from raw
+        counters; the shared strict-fit mapper (score desc, then
+        table/chunk/col asc; select only if bytes <= remaining budget,
+        budget = 3725884160) is re-run per variant. Report segment-count and
+        byte-weighted Jaccard vs the median placement.
+  B2-8  Dictionary event share (cumulative + per-cycle delta) and a DOCUMENTED
+        placement sensitivity that maps Dictionary accesses to a defensible
+        calibrated cost (point / random), reported against the published
+        four-pattern arm (dictionary excluded). The four-pattern arm itself is
+        NOT changed here; both outcomes are reported.
+
+Outputs (in --outdir):
+  sensitivity_calibration.json / .csv   B2-7 endpoints
+  sensitivity_dictionary.json / .csv    B2-8 share + mapping variants
+"""
+
+import argparse
+import csv
+import json
+from collections import defaultdict
+from pathlib import Path
+
+DRAM_BUDGET_BYTES = 3725884160
+GAMMAS = ["sequential", "monotonic", "random", "point"]
+
+
+def load_stats(path: Path) -> dict:
+    """(device, gamma, dtype) -> stats row."""
+    out = {}
+    for r in csv.DictReader(open(path)):
+        out[(r["device"], r["gamma"], r["data_type"])] = r
+    return out
+
+
+def calibration_value(stats: dict, variant: str) -> dict:
+    """(device, gamma, dtype) -> ns_per_access_per_byte under the variant."""
+    key = {"median": "median_ns_per_access_per_byte",
+           "lo": "ci95_low", "hi": "ci95_high"}[variant]
+    return {cell: float(row[key]) for cell, row in stats.items()}
+
+
+def benefit(counts: dict, bpv: int, dtype: str, calib: dict) -> float:
+    cost_dram = sum(calib[("dram", g, dtype)] * counts[g] * bpv for g in GAMMAS)
+    cost_cxl = sum(calib[("cxl", g, dtype)] * counts[g] * bpv for g in GAMMAS)
+    return cost_cxl - cost_dram
+
+
+def strict_fit(segments: list[dict], budget: int = DRAM_BUDGET_BYTES) -> set[int]:
+    """Shared deterministic strict-fit mapper (commit B2 semantics):
+    comparator = score desc, then table name, chunk id, column id ascending;
+    a segment is selected only when its bytes fit the remaining budget."""
+    order = sorted(range(len(segments)),
+                   key=lambda i: (-segments[i]["score"], segments[i]["table"],
+                                  segments[i]["chunk"], segments[i]["column"]))
+    remaining = budget
+    selected = set()
+    for i in order:
+        b = segments[i]["bytes"]
+        if b <= remaining:
+            selected.add(i)
+            remaining -= b
+    return selected
+
+
+def jaccard(a: set, b: set) -> float:
+    return len(a & b) / len(a | b) if (a | b) else 1.0
+
+
+def byte_weighted_jaccard(segments: list[dict], a: set, b: set) -> float:
+    inter = sum(segments[i]["bytes"] for i in a & b)
+    union = sum(segments[i]["bytes"] for i in a | b)
+    return inter / union if union else 1.0
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--trace", required=True)
+    ap.add_argument("--stats", required=True)
+    ap.add_argument("--outdir", required=True)
+    ap.add_argument("--cycle", default="last")
+    args = ap.parse_args()
+    outdir = Path(args.outdir)
+    outdir.mkdir(parents=True, exist_ok=True)
+
+    rows = list(csv.DictReader(open(args.trace)))
+    assert rows, "empty decision trace"
+    cycles = sorted({int(r["cycle_id"]) for r in rows})
+    cycle = cycles[-1] if args.cycle == "last" else int(args.cycle)
+    assert cycle in cycles, f"cycle {cycle} not in {cycles}"
+    snap = [r for r in rows if int(r["cycle_id"]) == cycle and r["policy"] == "cost_c3_greedy"]
+    assert snap, f"no cost_c3_greedy rows in cycle {cycle}"
+
+    # DTYPE normalization: trace data_type is the magic_enum-lower column type
+    # (int/long/float/double/string/null); calibration keys are the loader grid.
+    DTYPE_TO_CALIB = {"int": "int32", "long": "int64", "float": "float32",
+                      "double": "float64", "string": "string16", "null": "int64"}
+    CALIB_BYTES = {"int32": 4, "int64": 8, "float32": 4, "float64": 8, "string16": 16}
+
+    segments = []
+    for r in snap:
+        dtype = DTYPE_TO_CALIB[r["data_type"]]
+        bpv = int(float(r["bytes_per_value"]))
+        assert bpv == CALIB_BYTES[dtype], (r["data_type"], bpv, dtype)
+        counts = {"sequential": int(r["sequential_count"]),
+                  "monotonic": int(r["monotonic_count"]),
+                  "random": int(r["random_count"]),
+                  "point": int(r["point_count"])}
+        segments.append(dict(table=r["table_name"], chunk=int(r["chunk_id"]),
+                             column=int(r["column_id"]), dtype=dtype, bpv=bpv,
+                             counts=counts, dictionary=int(r["dictionary_count"]),
+                             bytes=int(r["data_volume_bytes"])))
+
+    stats = load_stats(Path(args.stats))
+
+    # ── B2-7: placement under median vs uncertainty endpoints ──────────────
+    cal_results = {}
+    placements = {}
+    for variant in ("median", "lo", "hi"):
+        calib = calibration_value(stats, variant)
+        for seg in segments:
+            seg["score"] = benefit(seg["counts"], seg["bpv"], seg["dtype"], calib)
+        placements[variant] = strict_fit(segments)
+        cal_results[variant] = dict(
+            selected_segments=len(placements[variant]),
+            selected_bytes=sum(segments[i]["bytes"] for i in placements[variant]),
+            benefit_total=sum(segments[i]["score"] for i in placements[variant]))
+
+    b27 = dict(
+        cycle=cycle,
+        segments=len(segments),
+        budget=DRAM_BUDGET_BYTES,
+        variants=cal_results,
+        jaccard_segment={v: jaccard(placements["median"], placements[v]) for v in ("lo", "hi")},
+        jaccard_byte_weighted={v: byte_weighted_jaccard(segments, placements["median"], placements[v])
+                               for v in ("lo", "hi")})
+
+    # ── B2-8: Dictionary event share + mapped-cost placement sensitivity ───
+    tot = {g: sum(s["counts"][g] for s in segments) for g in GAMMAS}
+    dict_total = sum(s["dictionary"] for s in segments)
+    all_events = sum(tot.values()) + dict_total
+    share_cumulative = dict_total / all_events if all_events else 0.0
+
+    # per-cycle delta share: dictionary delta vs total delta across consecutive cycles
+    dict_deltas, total_deltas = [], []
+    prev: dict[tuple, tuple] = {}
+    for r in rows:
+        if r["policy"] != "cost_c3_greedy":
+            continue
+        key = (r["table_name"], int(r["chunk_id"]), int(r["column_id"]))
+        cur = (int(r["sequential_count"]), int(r["monotonic_count"]), int(r["random_count"]),
+               int(r["point_count"]), int(r["dictionary_count"]))
+        if key in prev:
+            d4 = sum(c - p for c, p in zip(cur[:4], prev[key][:4]))
+            dd = cur[4] - prev[key][4]
+            if d4 + dd > 0:
+                dict_deltas.append(dd)
+                total_deltas.append(d4 + dd)
+        prev[key] = cur
+    dict_delta_sum, total_delta_sum = sum(dict_deltas), sum(total_deltas)
+    share_delta = dict_delta_sum / total_delta_sum if total_delta_sum else 0.0
+
+    # mapped-cost variants (documented): Dictionary -> point cost or random cost
+    # on BOTH devices, added to the four-pattern benefit. The published arm
+    # (excluded_reported) stays the reference.
+    calib_median = calibration_value(stats, "median")
+    dict_results = {}
+    dict_placements = {}
+    for mapping in ("excluded_reported", "point", "random"):
+        for seg in segments:
+            extra = {"excluded_reported": 0, "point": seg["dictionary"], "random": seg["dictionary"]}[mapping]
+            counts = dict(seg["counts"])
+            if mapping in ("point", "random"):
+                counts[mapping] += extra
+            seg["score"] = benefit(counts, seg["bpv"], seg["dtype"], calib_median)
+        dict_placements[mapping] = strict_fit(segments)
+        dict_results[mapping] = dict(
+            selected_segments=len(dict_placements[mapping]),
+            selected_bytes=sum(segments[i]["bytes"] for i in dict_placements[mapping]))
+
+    b28 = dict(
+        cycle=cycle,
+        dictionary_events_cumulative=dict_total,
+        four_pattern_events_cumulative=sum(tot.values()),
+        dictionary_share_cumulative=share_cumulative,
+        dictionary_events_delta=dict_delta_sum,
+        total_events_delta=total_delta_sum,
+        dictionary_share_delta=share_delta,
+        mapping_variants=dict_results,
+        jaccard_segment_vs_excluded={m: jaccard(dict_placements["excluded_reported"], dict_placements[m])
+                                     for m in ("point", "random")},
+        jaccard_byte_weighted_vs_excluded={m: byte_weighted_jaccard(
+            segments, dict_placements["excluded_reported"], dict_placements[m])
+            for m in ("point", "random")})
+
+    json.dump(dict(b27_calibration_sensitivity=b27, b28_dictionary_sensitivity=b28,
+                   inputs=dict(trace=str(args.trace), stats=str(args.stats), cycle=cycle)),
+              open(outdir / "sensitivity_results.json", "w"), indent=2)
+
+    with open(outdir / "sensitivity_calibration.csv", "w", newline="") as f:
+        w = csv.writer(f)
+        w.writerow(["variant", "selected_segments", "selected_bytes",
+                    "jaccard_segment_vs_median", "jaccard_byte_weighted_vs_median"])
+        for v in ("median", "lo", "hi"):
+            r = cal_results[v]
+            w.writerow([v, r["selected_segments"], r["selected_bytes"],
+                        1.0 if v == "median" else b27["jaccard_segment"][v],
+                        1.0 if v == "median" else b27["jaccard_byte_weighted"][v]])
+    with open(outdir / "sensitivity_dictionary.csv", "w", newline="") as f:
+        w = csv.writer(f)
+        w.writerow(["metric", "value"])
+        w.writerow(["dictionary_share_cumulative", share_cumulative])
+        w.writerow(["dictionary_share_per_cycle_delta", share_delta])
+        w.writerow(["dictionary_events_cumulative", dict_total])
+        w.writerow(["four_pattern_events_cumulative", sum(tot.values())])
+        for m in ("excluded_reported", "point", "random"):
+            w.writerow([f"selected_segments[{m}]", dict_results[m]["selected_segments"]])
+            w.writerow([f"selected_bytes[{m}]", dict_results[m]["selected_bytes"]])
+            if m != "excluded_reported":
+                w.writerow([f"jaccard_segment_vs_excluded[{m}]", b28["jaccard_segment_vs_excluded"][m]])
+                w.writerow([f"jaccard_byte_weighted_vs_excluded[{m}]",
+                            b28["jaccard_byte_weighted_vs_excluded"][m]])
+
+    print(json.dumps(dict(b27=b27["jaccard_segment"], b27_bytes=b27["jaccard_byte_weighted"],
+                          dict_share_cum=share_cumulative, dict_share_delta=share_delta,
+                          b28=b28["jaccard_segment_vs_excluded"]), indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/experiments/edbt_v4/c3_calibration_bench.cpp b/experiments/edbt_v4/c3_calibration_bench.cpp
new file mode 100644
index 000000000..041f55153
--- /dev/null
+++ b/experiments/edbt_v4/c3_calibration_bench.cpp
@@ -0,0 +1,184 @@
+// EDBT v4 Phase B (commit B3 prerequisite): C3 typed-cost calibration bench.
+//
+// Measures per-access latency of the four Hyrise access-pattern counters
+// (sequential / monotonic / random / point) for five data types on the DRAM
+// node (node1) and the CXL node (node2) of this machine. Output:
+//   calibration_raw.csv  one row per (device, gamma, data_type, repeat)
+//   (stdout)             medians; a tiny wrapper turns them into
+//   calibration.csv      device,gamma,data_type,ns_per_access_per_byte
+//
+// Model operationalization (documented in the Phase B POLICY_SPEC): the pack's
+// formula is  cost(s,dev) = Σ_γ calib(dev,γ,dtype) · count_γ(s) · bytes_per_value,
+// so calibration is measured as ns per access per byte and multiplied by the
+// column's bytes_per_value at scoring time. Buffers are bound with
+// mbind(MPOL_BIND) — strict, no fallback — and residency is verified from
+// /proc/self/numa_maps before timing.
+//
+// Point vs Random: Hyrise's Point counter is a one-entry position list and
+// Random a multi-entry out-of-order list; at single-value granularity both are
+// uniform random single-value accesses in a memory-cost model, so Point is
+// calibrated with the same uniform random index stream as Random (disclosed
+// limitation, not silently folded: both counters keep separate columns in the
+// decision trace).
+//
+// Build: clang++-17 -O2 -std=c++17 c3_calibration_bench.cpp -o c3_calibration_bench
+// Run:   taskset -c 96 ./c3_calibration_bench <out_csv> [accesses_per_repeat]
+
+#include <algorithm>
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <ctime>
+#include <random>
+#include <string>
+#include <sys/mman.h>
+#include <unistd.h>
+#include <vector>
+
+// numa policy constants (glibc's <numaif.h> needs libnuma for mbind(); declare manually)
+#include <linux/mempolicy.h>
+extern "C" long mbind(void*, unsigned long, int, const unsigned long*, unsigned long, unsigned);
+
+namespace {
+
+constexpr size_t kRepeats = 5;
+
+struct DType {
+  const char* name;
+  size_t bytes;
+};
+
+const DType kTypes[] = {
+    {"int32", 4}, {"int64", 8}, {"float32", 4}, {"float64", 8}, {"string16", 16},
+};
+
+double now_ns() {
+  auto ts = timespec{};
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return static_cast<double>(ts.tv_sec) * 1e9 + static_cast<double>(ts.tv_nsec);
+}
+
+void* bind_buffer(size_t bytes, int node) {
+  void* p = mmap(nullptr, bytes, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  if (p == MAP_FAILED) return nullptr;
+  unsigned long mask = 1UL << node;
+  if (mbind(p, bytes, MPOL_BIND, &mask, sizeof(mask) * 8, MPOL_MF_MOVE) != 0) {
+    munmap(p, bytes);
+    return nullptr;
+  }
+  return p;
+}
+
+bool verify_residency(const char* tag, int node) {
+  // Count pages on each node in /proc/self/numa_maps; require >=99% on target.
+  auto* f = std::fopen("/proc/self/numa_maps", "r");
+  if (!f) return false;
+  char line[4096];
+  long long total = 0, target = 0;
+  char target_tag[8];
+  std::snprintf(target_tag, sizeof(target_tag), "N%d=", node);
+  while (std::fgets(line, sizeof(line), f)) {
+    for (char* tok = std::strtok(line, " \n"); tok; tok = std::strtok(nullptr, " \n")) {
+      if (std::strncmp(tok, "N", 1) == 0 && std::strchr(tok, '=')) {
+        long long pages = std::atoll(std::strchr(tok, '=') + 1);
+        total += pages;
+        if (std::strncmp(tok, target_tag, std::strlen(target_tag)) == 0) target += pages;
+      }
+    }
+  }
+  std::fclose(f);
+  const bool ok = total > 0 && static_cast<double>(target) / total >= 0.99;
+  std::printf("# residency[%s]: target N%d = %lld / %lld pages (%.4f) -> %s\n", tag, node, target,
+              total, total ? static_cast<double>(target) / total : 0.0, ok ? "OK" : "FAIL");
+  return ok;
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  if (argc < 2) {
+    std::fprintf(stderr, "usage: %s <out_csv> [accesses_per_repeat]\n", argv[0]);
+    return 2;
+  }
+  const std::string out_path = argv[1];
+  const size_t n_access = argc > 2 ? std::stoull(argv[2]) : 32u * 1024 * 1024;  // 32M per repeat
+
+  // ≥ 512 MiB PER TYPE (LLC here is 864 MiB / 2 sockets = 432 MiB per socket):
+  // n_values scales with bytes_per_value; one buffer per (device, dtype),
+  // mapped/unmapped sequentially (peak RSS ≈ buffer + index vectors).
+  const auto values_for = [](size_t bytes) {
+    return std::max<size_t>(536870912ull / bytes, 8u * 1024 * 1024);
+  };
+
+  auto* out = std::fopen(out_path.c_str(), "w");
+  if (!out) {
+    std::perror("fopen");
+    return 2;
+  }
+  std::fprintf(out,
+               "device,gamma,data_type,repeat,accesses,buffer_bytes,bytes_per_value,"
+               "ns_total,ns_per_access,ns_per_access_per_byte\n");
+
+  long long checksum = 0;  // sink so accesses are not optimized away
+  for (int node : {1, 2}) {
+    const char* device = node == 1 ? "dram" : "cxl";  // lowercase: loader grid keys
+    for (const auto& type : kTypes) {
+      const size_t n_values = values_for(type.bytes);
+      const size_t buffer_bytes = n_values * type.bytes;
+      auto* buf = static_cast<uint8_t*>(bind_buffer(buffer_bytes, node));
+      if (!buf) {
+        std::fprintf(stderr, "mbind/mmap failed for node %d (%zu bytes)\n", node, buffer_bytes);
+        return 2;
+      }
+      std::memset(buf, 1, buffer_bytes);
+      if (!verify_residency(type.name, node)) {
+        std::fprintf(stderr, "residency verification failed (node %d, %s)\n", node, type.name);
+        return 2;
+      }
+
+      // Index streams
+      auto indices = std::vector<size_t>(n_values);
+      for (size_t i = 0; i < n_values; ++i) indices[i] = i;
+      auto rng = std::mt19937_64(0xC3C3C3C3C3C3C3C3ull);
+      std::shuffle(indices.begin(), indices.end(), rng);  // random stream
+      // monotonic stream: stride 2 over a rotated window (monotone, gaps)
+      auto mono = std::vector<size_t>(n_values / 2);
+      for (size_t i = 0; i < mono.size(); ++i) mono[i] = (i * 2 + n_values / 4) % n_values;
+
+      for (const char* gamma : {"sequential", "monotonic", "random", "point"}) {
+        for (size_t repeat = 0; repeat < kRepeats; ++repeat) {
+          // Warm the TLB / page tables once (not timed)
+          for (size_t i = 0; i < 65536; ++i) checksum += buf[i * type.bytes % buffer_bytes];
+          const auto t0 = now_ns();
+          if (std::strcmp(gamma, "sequential") == 0) {
+            for (size_t k = 0; k < n_access; ++k) {
+              const size_t idx = k % n_values;
+              checksum += buf[idx * type.bytes];
+            }
+          } else if (std::strcmp(gamma, "monotonic") == 0) {
+            for (size_t k = 0; k < n_access; ++k) {
+              const size_t idx = mono[k % mono.size()];
+              checksum += buf[idx * type.bytes];
+            }
+          } else {  // random == point: uniform random single-value accesses
+            for (size_t k = 0; k < n_access; ++k) {
+              const size_t idx = indices[k % n_values];
+              checksum += buf[idx * type.bytes];
+            }
+          }
+          const auto t1 = now_ns();
+          const double ns_total = t1 - t0;
+          const double ns_per_access = ns_total / static_cast<double>(n_access);
+          std::fprintf(out, "%s,%s,%s,%zu,%zu,%zu,%zu,%.3f,%.6f,%.9f\n", device, gamma, type.name,
+                       repeat, n_access, buffer_bytes, type.bytes, ns_total, ns_per_access,
+                       ns_per_access / static_cast<double>(type.bytes));
+        }
+      }
+      munmap(buf, buffer_bytes);
+    }
+  }
+  std::fclose(out);
+  std::fprintf(stderr, "# checksum sink: %lld\n", checksum);
+  return 0;
+}
diff --git a/experiments/edbt_v4/c3_calibration_bench_v2.cpp b/experiments/edbt_v4/c3_calibration_bench_v2.cpp
new file mode 100644
index 000000000..db37da93b
--- /dev/null
+++ b/experiments/edbt_v4/c3_calibration_bench_v2.cpp
@@ -0,0 +1,305 @@
+// EDBT v4 Phase B2: C3 typed-cost calibration bench, v2 (B2-6 redo).
+//
+// Fixes vs the Phase B (commit B3) bench, per the B2 review:
+//   1. UNIQUE working set per timed cell: one fresh mbind(MPOL_BIND) buffer
+//      per (device, gamma, data_type) cell — 40 cells, no sharing of a buffer
+//      between patterns. Each timed pass touches >= 1.25x the per-socket LLC
+//      in DISTINCT bytes (monotonic stride-2 cells use a 2.5x-LLC buffer so
+//      their touched half still exceeds the LLC; string16/point disclosed
+//      below). LLC size is read from sysfs at startup and logged.
+//   2. LLC scrub before EVERY timed repeat (sequential walk of a dedicated
+//      1.5x-LLC cleaner buffer): repeat 0 is no longer biased by memset-warm
+//      lines; all repeats measure the same cold-LLC state.
+//   3. Randomized cell order: the 40 cells are shuffled with a FIXED seed
+//      (mt19937_64, 0xB2C3D4E5F6071829ull) and executed in that order, so
+//      device/dtype adjacency effects do not align with the systematic
+//      enumeration order.
+//   4. 12 retained repeats per cell (>= 10 required); every repeat's raw row
+//      is written; nothing is deleted or re-run based on outcomes.
+//      Dispersion/uncertainty (median, MAD, IQR, distribution-free median CI)
+//      are computed by the aggregation script, never inside this bench.
+//
+// Model operationalization (unchanged from Phase B, documented in POLICY_SPEC):
+//   cost(s,dev) = sum_gamma calib(dev,gamma,dtype) * count_gamma(s) * bpv,
+//   so calibration is ns per access per byte.
+//
+// Disclosed limitations (not silently folded):
+//   - Point vs Random: Hyrise's Point counter is a one-entry position list and
+//     Random a multi-entry out-of-order list; at single-value granularity both
+//     are uniform random single-value accesses, so Point uses the same stream
+//     SHAPE as Random but on its own unique buffer and its own shuffled index
+//     stream (separate trace columns, separate calibration cells).
+//   - string16: fixed 16-byte payloads emulating pmr_string's in-row size;
+//     variable-length overflow is not modeled.
+//
+// Build: clang++-17 -O2 -std=c++17 c3_calibration_bench_v2.cpp -o c3_calibration_bench_v2
+// Run:   taskset -c <core-of-node1> ./c3_calibration_bench_v2 <out_raw_csv>
+
+#include <algorithm>
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <ctime>
+#include <filesystem>
+#include <map>
+#include <random>
+#include <string>
+#include <sys/mman.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#include <vector>
+
+// numa policy constants + raw syscall (mbind() is not exported by this
+// system's libc; use the kernel syscall directly — no libnuma dependency)
+#include <linux/mempolicy.h>
+static long mbind_raw(void* addr, unsigned long len, int mode, const unsigned long* nodemask,
+                      unsigned long maxnode, unsigned flags) {
+  return syscall(SYS_mbind, addr, len, mode, nodemask, maxnode, flags);
+}
+
+namespace {
+
+constexpr size_t kRepeats = 12;  // B2-6: >= 10 retained repeats
+constexpr uint64_t kCellOrderSeed = 0xB2C3D4E5F6071829ull;
+constexpr double kDistinctBytesLLCFactor = 1.25;  // timed distinct bytes >= 1.25x LLC
+constexpr double kScrubLLCFactor = 1.5;           // cleaner buffer = 1.5x LLC
+
+struct DType {
+  const char* name;
+  size_t bytes;
+};
+
+const DType kTypes[] = {
+    {"int32", 4}, {"int64", 8}, {"float32", 4}, {"float64", 8}, {"string16", 16},
+};
+
+struct Cell {
+  int node;
+  const char* device;
+  const char* gamma;
+  const DType* type;
+  size_t order_index;  // position in the shuffled execution order
+};
+
+double now_ns() {
+  auto ts = timespec{};
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return static_cast<double>(ts.tv_sec) * 1e9 + static_cast<double>(ts.tv_nsec);
+}
+
+// Per-socket LLC size in bytes from sysfs (fallback: 432 MiB, this machine's L3).
+size_t read_llc_bytes() {
+  const char* path = "/sys/devices/system/cpu/cpu0/cache/index3/size";
+  auto* f = std::fopen(path, "r");
+  if (!f) return 432ull * 1024 * 1024;
+  char buf[64];
+  const char* read = std::fgets(buf, sizeof(buf), f);
+  std::fclose(f);
+  if (!read) return 432ull * 1024 * 1024;
+  double value = 0.0;
+  char unit = 'K';
+  if (std::sscanf(buf, "%lf%c", &value, &unit) >= 1) {
+    double mul = unit == 'G' ? 1024.0 * 1024 * 1024 : (unit == 'M' ? 1024.0 * 1024 : 1024.0);
+    return static_cast<size_t>(value * mul);
+  }
+  return 432ull * 1024 * 1024;
+}
+
+size_t round_up_2mib(size_t bytes) { return (bytes + (2ull << 20) - 1) & ~static_cast<size_t>((2ull << 20) - 1); }
+
+void* bind_buffer(size_t bytes, int node) {
+  void* p = mmap(nullptr, bytes, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  if (p == MAP_FAILED) return nullptr;
+  unsigned long mask = 1UL << node;
+  if (mbind_raw(p, bytes, MPOL_BIND, &mask, sizeof(mask) * 8, MPOL_MF_MOVE) != 0) {
+    munmap(p, bytes);
+    return nullptr;
+  }
+  return p;
+}
+
+// Residency of ONE mapping. /proc/self/numa_maps prints one line per VMA with
+// only a START address (no end), lines sorted ascending: the region
+// containing `ptr` is the last line whose start <= ptr. Pages counted are
+// that region's; require >= 99% on the target node. (The process keeps other
+// node-bound buffers mapped — cell buffer + its node's scrubber — so a global
+// fraction would be meaningless; Phase B's bench mapped one buffer at a time.)
+bool verify_residency(const char* tag, void* ptr, int node) {
+  auto* f = std::fopen("/proc/self/numa_maps", "r");
+  if (!f) return false;
+  char line[8192];
+  char region_line[8192] = {0};
+  const auto target_addr = reinterpret_cast<uintptr_t>(ptr);
+  auto region_start = 0ull;
+  while (std::fgets(line, sizeof(line), f)) {
+    unsigned long long start = 0;
+    if (std::sscanf(line, "%llx", &start) != 1) continue;
+    if (start > target_addr) break;
+    if (start >= region_start) {
+      region_start = start;
+      std::strncpy(region_line, line, sizeof(region_line) - 1);
+    }
+  }
+  std::fclose(f);
+  long long total = 0, target = 0;
+  char target_tag[8];
+  std::snprintf(target_tag, sizeof(target_tag), "N%d=", node);
+  for (char* tok = std::strtok(region_line, " \n"); tok; tok = std::strtok(nullptr, " \n")) {
+    if (std::strncmp(tok, "N", 1) == 0 && std::strchr(tok, '=')) {
+      long long pages = std::atoll(std::strchr(tok, '=') + 1);
+      total += pages;
+      if (std::strncmp(tok, target_tag, std::strlen(target_tag)) == 0) target += pages;
+    }
+  }
+  const bool ok = total > 0 && static_cast<double>(target) / total >= 0.99;
+  std::printf("# residency[%s]: target N%d = %lld / %lld pages (%.4f) -> %s\n", tag, node, target,
+              total, total ? static_cast<double>(target) / total : 0.0, ok ? "OK" : "FAIL");
+  return ok;
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  if (argc < 2) {
+    std::fprintf(stderr, "usage: %s <out_raw_csv>\n", argv[0]);
+    return 2;
+  }
+  const std::string out_path = argv[1];
+
+  const size_t llc_bytes = read_llc_bytes();
+  const size_t distinct_target = round_up_2mib(static_cast<size_t>(kDistinctBytesLLCFactor *
+                                                                   static_cast<double>(llc_bytes)));
+  const size_t scrub_bytes = round_up_2mib(static_cast<size_t>(kScrubLLCFactor *
+                                                               static_cast<double>(llc_bytes)));
+  std::printf("# llc_bytes=%zu (%.1f MiB) distinct_target=%zu scrub_bytes=%zu repeats=%zu\n",
+              llc_bytes, llc_bytes / 1048576.0, distinct_target, scrub_bytes, kRepeats);
+
+  // ── Build the 40-cell grid, then shuffle into a fixed-seed execution order ──
+  auto cells = std::vector<Cell>{};
+  for (int node : {1, 2}) {
+    for (const auto& type : kTypes) {
+      for (const char* gamma : {"sequential", "monotonic", "random", "point"}) {
+        cells.push_back(Cell{node, node == 1 ? "dram" : "cxl", gamma, &type, 0});
+      }
+    }
+  }
+  {
+    auto order = std::vector<size_t>(cells.size());
+    for (size_t i = 0; i < order.size(); ++i) order[i] = i;
+    auto rng = std::mt19937_64(kCellOrderSeed);
+    std::shuffle(order.begin(), order.end(), rng);
+    for (size_t position = 0; position < order.size(); ++position) {
+      cells[order[position]].order_index = position;
+    }
+  }
+  std::stable_sort(cells.begin(), cells.end(),
+                   [](const Cell& a, const Cell& b) { return a.order_index < b.order_index; });
+
+  auto* out = std::fopen(out_path.c_str(), "w");
+  if (!out) {
+    std::perror("fopen");
+    return 2;
+  }
+  std::fprintf(out,
+               "device,gamma,data_type,repeat,cell_order,accesses,buffer_bytes,working_set_bytes,"
+               "bytes_per_value,ns_total,ns_per_access,ns_per_access_per_byte\n");
+
+  // Dedicated LLC scrub buffer per node (bound like the cells; walked
+  // sequentially before every timed repeat to evict residual lines).
+  auto scrub_buffers = std::map<int, uint8_t*>{};
+  for (int node : {1, 2}) {
+    auto* scrub = static_cast<uint8_t*>(bind_buffer(scrub_bytes, node));
+    if (!scrub) {
+      std::fprintf(stderr, "scrub buffer alloc failed for node %d\n", node);
+      return 2;
+    }
+    std::memset(scrub, 3, scrub_bytes);
+    scrub_buffers[node] = scrub;
+  }
+  if (!verify_residency("scrub_n1", scrub_buffers[1], 1) || !verify_residency("scrub_n2", scrub_buffers[2], 2)) {
+    std::fprintf(stderr, "scrub buffer residency verification failed\n");
+    return 2;
+  }
+
+  long long checksum = 0;  // sink so accesses are not optimized away
+  for (const auto& cell : cells) {
+    // Buffer sizing (B2-6): distinct bytes touched by ONE timed pass must
+    // exceed the LLC. sequential/random/point cover distinct_target bytes;
+    // monotonic (stride-2, gaps) touches half its buffer, so its buffer is
+    // 2x distinct_target.
+    const size_t buffer_bytes =
+        std::strcmp(cell.gamma, "monotonic") == 0 ? 2 * distinct_target : distinct_target;
+    const size_t n_values = buffer_bytes / cell.type->bytes;
+    // accesses per pass: sequential/random/point touch every value exactly
+    // once (full buffer coverage); monotonic walks its whole 2x buffer with
+    // stride 2 (half the values, still >= 1.25x LLC distinct bytes).
+    const size_t n_access = n_values;
+
+    auto* buf = static_cast<uint8_t*>(bind_buffer(buffer_bytes, cell.node));
+    if (!buf) {
+      std::fprintf(stderr, "mbind/mmap failed for node %d (%zu bytes)\n", cell.node, buffer_bytes);
+      return 2;
+    }
+    std::memset(buf, 1, buffer_bytes);
+    char tag[64];
+    std::snprintf(tag, sizeof(tag), "%s_%s_%s", cell.device, cell.gamma, cell.type->name);
+    if (!verify_residency(tag, buf, cell.node)) {
+      std::fprintf(stderr, "residency verification failed (%s)\n", tag);
+      return 2;
+    }
+
+    // Index streams for this cell's UNIQUE buffer.
+    // random: full Fisher-Yates shuffle (touches every value once per pass).
+    // point: same stream shape, independently seeded shuffle of the same
+    //        buffer (disclosed Point==Random limitation, unique working set).
+    auto indices = std::vector<size_t>(n_values);
+    for (size_t i = 0; i < n_values; ++i) indices[i] = i;
+    auto rng = std::mt19937_64(0xC3C3C3C3C3C3C3C3ull + cell.order_index);  // per-cell stream
+    std::shuffle(indices.begin(), indices.end(), rng);
+    // monotonic stream: stride 2 over a rotated window (monotone, gaps).
+    auto mono = std::vector<size_t>(n_values / 2);
+    for (size_t i = 0; i < mono.size(); ++i) mono[i] = (i * 2 + n_values / 4) % n_values;
+
+    for (size_t repeat = 0; repeat < kRepeats; ++repeat) {
+      // LLC scrub (not timed): evict memset/prior-repeat residual lines.
+      {
+        auto* scrub = scrub_buffers[cell.node];
+        const size_t scrub_stride = 64;  // one cache line per step
+        for (size_t off = 0; off + scrub_stride <= scrub_bytes; off += scrub_stride) {
+          checksum += scrub[off];
+        }
+      }
+      const auto t0 = now_ns();
+      if (std::strcmp(cell.gamma, "sequential") == 0) {
+        for (size_t k = 0; k < n_access; ++k) {
+          checksum += buf[(k % n_values) * cell.type->bytes];
+        }
+      } else if (std::strcmp(cell.gamma, "monotonic") == 0) {
+        for (size_t k = 0; k < n_access; ++k) {
+          checksum += buf[mono[k % mono.size()] * cell.type->bytes];
+        }
+      } else {  // random and point: independent uniform random single-value streams
+        for (size_t k = 0; k < n_access; ++k) {
+          checksum += buf[indices[k % n_values] * cell.type->bytes];
+        }
+      }
+      const auto t1 = now_ns();
+      const double ns_total = t1 - t0;
+      const double ns_per_access = ns_total / static_cast<double>(n_access);
+      const size_t working_set_bytes =
+          std::strcmp(cell.gamma, "monotonic") == 0 ? (n_access / 2) * cell.type->bytes
+                                                    : n_access * cell.type->bytes;
+      std::fprintf(out, "%s,%s,%s,%zu,%zu,%zu,%zu,%zu,%zu,%.3f,%.6f,%.9f\n", cell.device, cell.gamma,
+                   cell.type->name, repeat, cell.order_index, n_access, buffer_bytes,
+                   working_set_bytes, cell.type->bytes, ns_total, ns_per_access,
+                   ns_per_access / static_cast<double>(cell.type->bytes));
+    }
+    std::fflush(out);
+    std::printf("# cell done: %s (order %zu)\n", tag, cell.order_index);
+    munmap(buf, buffer_bytes);
+  }
+  std::fclose(out);
+  std::fprintf(stderr, "# checksum sink: %lld\n", checksum);
+  return 0;
+}
diff --git a/experiments/edbt_v4/collect_proofs_phase_b.py b/experiments/edbt_v4/collect_proofs_phase_b.py
new file mode 100644
index 000000000..50d68b86d
--- /dev/null
+++ b/experiments/edbt_v4/collect_proofs_phase_b.py
@@ -0,0 +1,445 @@
+#!/usr/bin/env python3
+"""EDBT v4 Phase B: collect the ten required proofs from the smoke bundles.
+
+Reads the bundles produced by run_smoke_phase_b.py (plus the calibration CSV)
+and writes results_edbt_v4/01_phase_b/PROOFS.json and PROOFS.md.
+
+Proofs (numbering follows PROMPT_FOR_PHASE_B_AGENT.md):
+ 1  the three migration configs rank the SAME candidate segment set
+ 2  deterministic tie-break + strict fit never exceed the byte budget per cycle
+ 3  semantic scores recomputable from atype/freq/volume/immutable (1e-9)
+ 4  C3 scores recomputable from the four pattern counters + calibration
+ 5  dictionary counters reported AND excluded (excluded_reported)
+ 6  >= 2 pattern counters non-zero on traced segments
+ 7  same schedule seed -> identical plan + manifest prefix; different seed -> fork
+ 8  dram_only / cxl_only residency within the pre-declared 5% off-target bound
+ 9  operator rows declare attribution_level; unavailable reads stay null (empty)
+10  CXL device / platform identity evidence exists in environment/
+"""
+from __future__ import annotations
+
+import csv
+import hashlib
+import io
+import json
+import math
+import sys
+from collections import Counter, defaultdict
+from pathlib import Path
+
+ROOT = Path("/home/dameng/CXL_migration/hyrise")
+PHASE_B = ROOT / "results_edbt_v4/01_phase_b"
+RUNS = PHASE_B / "smoke_runs"
+CALIB = PHASE_B / "calibration/calibration.csv"
+BUDGET = 3725884160
+# Trace `data_type` prints the DataType enum name in lowercase (magic_enum);
+# plugin maps the enum to calibration grid keys (semantic_placement_plugin.cpp B3).
+DTYPE_TO_CALIB = {"int": "int32", "long": "int64", "float": "float32",
+                  "double": "float64", "string": "string16", "null": "int64"}
+CALIB_BYTES = {"int32": 4, "int64": 8, "float32": 4, "float64": 8, "string16": 16}
+GAMMAS = ("sequential", "monotonic", "random", "point")
+
+
+def sha256_file(path: Path) -> str:
+    h = hashlib.sha256()
+    with path.open("rb") as f:
+        for chunk in iter(lambda: f.read(1 << 20), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def read_csv_rows(path: Path):
+    with path.open(newline="", encoding="utf-8") as f:
+        yield from csv.DictReader(f)
+
+
+def read_plan(path: Path) -> list[dict]:
+    """schedule_plan.csv: meta header line + meta row, then the real header + rows."""
+    lines = path.read_text().splitlines()
+    assert lines[0] == "seed,item_count,plan_length", lines[0]
+    reader = csv.DictReader(io.StringIO("\n".join(lines[2:])))
+    assert reader.fieldnames == ["submission_index", "item_id", "item_name"], reader.fieldnames
+    return list(reader)
+
+
+def load_calibration() -> dict[tuple[str, str, str], float]:
+    rates = {}
+    for row in read_csv_rows(CALIB):
+        rates[(row["device"], row["gamma"], row["data_type"])] = float(row["ns_per_access_per_byte"])
+    return rates
+
+
+def close(actual: float, expected: float, rel: float, abs_tol: float) -> bool:
+    return math.isclose(actual, expected, rel_tol=rel, abs_tol=abs_tol)
+
+
+def candidate_key(row) -> tuple:
+    return (row["table_name"], int(row["chunk_id"]), int(row["column_id"]))
+
+
+def set_digest(keys) -> str:
+    keys = sorted(keys)
+    return hashlib.sha256("|".join(f"{t}:{c}:{k}" for t, c, k in keys).encode()).hexdigest()
+
+
+def first_cycle_candidates(path: Path) -> tuple[str, list[int]]:
+    """Candidate set per daemon cycle of one decision trace; returns
+    (hash of first cycle's set, per-cycle sizes)."""
+    per_cycle: dict[str, set] = defaultdict(set)
+    for row in read_csv_rows(path):
+        per_cycle[row["cycle_id"]].add(candidate_key(row))
+    sizes = [len(per_cycle[c]) for c in sorted(per_cycle, key=int)]
+    return set_digest(per_cycle[sorted(per_cycle, key=int)[0]]), sizes
+
+
+def proof_1(proofs: dict) -> None:
+    """All three migration configs rank the SAME candidate set.
+
+    Two layers, both reported:
+    * mapper layer (what the policies actually compete on): the per-cycle
+      candidate set of the decision trace — must be identical across all three
+      configs;
+    * initial placement pass: our_full/cost_c3_greedy derive candidates from
+      plan analysis (plan-referenced segments), our_freq (--ablate_d1, no plan)
+      enumerates the whole storage — a strict SUPERSET by design (v3 semantics).
+      The relation is verified, the difference documented, not hidden.
+    """
+    trace_bundles = {"our_full": "smoke_our_full_traceon",
+                     "our_freq": "smoke_our_freq_traceon",
+                     "cost_c3_greedy": "smoke_cost_c3_greedy_traceon"}
+    mapper_hashes, mapper_sizes = {}, {}
+    for config, bundle in trace_bundles.items():
+        digest, sizes = first_cycle_candidates(RUNS / bundle / "decision_trace.csv")
+        mapper_hashes[config] = digest
+        mapper_sizes[config] = {"cycles": len(sizes), "min": min(sizes), "max": max(sizes)}
+    initial_sets = {}
+    for config, bundle in (("our_full", "smoke_our_full"),
+                           ("our_freq", "smoke_our_freq"),
+                           ("cost_c3_greedy", "smoke_cost_c3_greedy")):
+        keys = {candidate_key(row)
+                for row in read_csv_rows(RUNS / bundle / "benchmark_semantic_placement.csv")}
+        initial_sets[config] = {"sha256": set_digest(keys), "segments": len(keys)}
+    full_keys = None
+    if initial_sets["our_freq"]["segments"] >= initial_sets["our_full"]["segments"]:
+        full_keys = {candidate_key(row)
+                     for row in read_csv_rows(RUNS / "smoke_our_freq" / "benchmark_semantic_placement.csv")}
+    plan_keys = {candidate_key(row)
+                 for row in read_csv_rows(RUNS / "smoke_our_full" / "benchmark_semantic_placement.csv")}
+    is_superset = full_keys is not None and plan_keys.issubset(full_keys)
+    proofs["1_candidate_set"] = {
+        "mapper_layer": {
+            "description": "per-daemon-cycle candidate set (decision trace), the set the "
+                           "policies actually rank",
+            "candidate_set_sha256": mapper_hashes, "per_cycle_sizes": mapper_sizes,
+            "identical_across_configs": len(set(mapper_hashes.values())) == 1,
+        },
+        "initial_placement_layer": {
+            "description": "first placement pass before the benchmark starts",
+            "sets": initial_sets,
+            "our_full_equals_cost_c3_greedy": (initial_sets["our_full"]["sha256"]
+                                               == initial_sets["cost_c3_greedy"]["sha256"]),
+            "our_freq_is_strict_superset": is_superset,
+            "note": "our_freq (--ablate_d1) has no plan info, so its initial pass "
+                    "enumerates the whole storage — the plan-referenced set of the other "
+                    "two arms is a subset of it. From the first daemon cycle onward all "
+                    "arms rank the full storage set (mapper layer).",
+        },
+        "pass": (len(set(mapper_hashes.values())) == 1
+                 and initial_sets["our_full"]["sha256"] == initial_sets["cost_c3_greedy"]["sha256"]
+                 and is_superset),
+    }
+
+
+def proof_2_3(proofs: dict) -> None:
+    """Strict-fit budget + comparator order (P2) and semantic score recompute (P3)."""
+    path = RUNS / "smoke_our_full_traceon" / "decision_trace.csv"
+    per_cycle_selected = defaultdict(int)
+    tie_violations = 0
+    fit_violations = 0
+    term_failures = 0
+    worst_term_err = 0.0
+    worst_total_err = 0.0
+    term_rows = 0
+    cycles: dict[str, list] = defaultdict(list)
+    for row in read_csv_rows(path):
+        cycles[row["cycle_id"]].append(row)
+    for rows in cycles.values():
+        rows.sort(key=lambda r: int(r["rank"]))
+        prev = None
+        for row in rows:
+            score = float(row["total_score"])
+            key3 = (row["table_name"], int(row["chunk_id"]), int(row["column_id"]))
+            if prev is not None:
+                p_score, p_key = prev
+                if not (p_score > score or (p_score == score and p_key < key3)):
+                    tie_violations += 1
+            prev = (score, key3)
+            seg_bytes = int(row["segment_bytes"])
+            before = int(row["remaining_budget_before"])
+            after = int(row["remaining_budget_after"])
+            selected = row["selected"] == "true"
+            fits = row["fits_remaining"] == "true"
+            # strict fit: selected  <=>  segment fits the remaining budget at its rank
+            if selected != fits or fits != (seg_bytes <= before):
+                fit_violations += 1
+            if selected and after != before - seg_bytes:
+                fit_violations += 1
+            if not selected and after != before:
+                fit_violations += 1
+            if selected and row["target_tier"] == "DRAM":
+                per_cycle_selected[(row["run_id"], row["cycle_id"])] += seg_bytes
+            # P3: recompute semantic score from the four published terms
+            terms = [float(row["term_atype"]), float(row["term_freq"]),
+                     float(row["term_volume"]), float(row["term_immutable"])]
+            ok = True
+            for w, feat, term in (("weight_atype", "atype_score", "term_atype"),
+                                  ("weight_freq", "norm_freq", "term_freq"),
+                                  ("weight_volume", "norm_volume", "term_volume"),
+                                  ("weight_immutable", "immutable_score", "term_immutable")):
+                expected_term = float(row[w]) * float(row[feat])
+                err = abs(float(row[term]) - expected_term)
+                worst_term_err = max(worst_term_err, err)
+                if not close(float(row[term]), expected_term, rel=1e-9, abs_tol=1e-12):
+                    ok = False
+            err = abs(score - sum(terms))
+            worst_total_err = max(worst_total_err, err)
+            if not ok or not close(score, sum(terms), rel=1e-9, abs_tol=1e-12):
+                term_failures += 1
+            term_rows += 1
+    over_budget = {f"{rid}:{cid}": b for (rid, cid), b in per_cycle_selected.items() if b > BUDGET}
+    max_cycle_bytes = max(per_cycle_selected.values()) if per_cycle_selected else 0
+    proofs["2_strict_fit_budget"] = {
+        "budget_bytes": BUDGET, "cycles_checked": len(cycles),
+        "tie_break_violations": tie_violations, "fit_invariant_violations": fit_violations,
+        "max_selected_bytes_in_any_cycle": max_cycle_bytes,
+        "cycles_over_budget": over_budget,
+        "pass": tie_violations == 0 and fit_violations == 0 and not over_budget,
+    }
+    proofs["3_semantic_recompute"] = {
+        "rows_checked": term_rows, "recompute_failures": term_failures,
+        "max_abs_term_error": worst_term_err, "max_abs_total_error": worst_total_err,
+        "tolerance": "math.isclose(rel_tol=1e-9, abs_tol=1e-12)",
+        "pass": term_failures == 0,
+    }
+
+
+def proof_4_5_6(proofs: dict) -> None:
+    """C3 recompute (P4), dictionary excluded_reported (P5), counters >=2 (P6)."""
+    rates = load_calibration()
+    path = RUNS / "smoke_cost_c3_greedy_traceon" / "decision_trace.csv"
+    cost_failures = 0
+    total_failures = 0
+    worst_cost_rel = 0.0
+    worst_total_err = 0.0
+    rows_checked = 0
+    dict_rows = 0
+    dict_sum = 0
+    handling_values = Counter()
+    counter_rows_ge2 = 0
+    total_rows = 0
+    gamma_totals = Counter()
+    for row in read_csv_rows(path):
+        total_rows += 1
+        handling_values[row["dictionary_handling"]] += 1
+        if row["dictionary_count"]:
+            dict_count = int(row["dictionary_count"])
+            if dict_count > 0:
+                dict_rows += 1
+                dict_sum += dict_count
+        counts = {g: int(row[f"{g}_count"]) for g in GAMMAS}
+        nonzero = sum(1 for v in counts.values() if v > 0)
+        if nonzero >= 2:
+            counter_rows_ge2 += 1
+        for g, v in counts.items():
+            gamma_totals[g] += v
+        calib_key = DTYPE_TO_CALIB[row["data_type"]]
+        bpv = float(row["bytes_per_value"])
+        if bpv != CALIB_BYTES[calib_key]:
+            cost_failures += 1  # trace bytes_per_value disagrees with the mapped dtype width
+            rows_checked += 1
+            continue
+        row_cost_ok = True
+        for device, col in (("dram", "cost_dram"), ("cxl", "cost_cxl")):
+            expected = sum(rates[(device, g, calib_key)] * counts[g] * bpv for g in GAMMAS)
+            actual = float(row[col])
+            denom = max(abs(expected), 1e-12)
+            worst_cost_rel = max(worst_cost_rel, abs(actual - expected) / denom)
+            if not close(actual, expected, rel=1e-9, abs_tol=1e-6):
+                row_cost_ok = False
+        if not row_cost_ok:
+            cost_failures += 1
+        total = float(row["total_score"])
+        expected_total = float(row["cost_cxl"]) - float(row["cost_dram"])
+        worst_total_err = max(worst_total_err, abs(total - expected_total))
+        if not close(total, expected_total, rel=1e-9, abs_tol=1e-6):
+            total_failures += 1
+        rows_checked += 1
+    proofs["4_c3_recompute"] = {
+        "rows_checked": rows_checked, "calibration_csv": str(CALIB),
+        "calibration_sha256": sha256_file(CALIB),
+        "formula": "cost = sum_g calib[device][g][dtype] * count_g * bytes_per_value; "
+                   "total_score = cost_cxl - cost_dram",
+        "cost_recompute_failures": cost_failures, "total_recompute_failures": total_failures,
+        "max_rel_cost_error": worst_cost_rel, "max_abs_total_error": worst_total_err,
+        "tolerance": "math.isclose(rel_tol=1e-9, abs_tol=1e-6) — abs headroom covers the "
+                     "fixed-precision CSV columns",
+        "pass": cost_failures == 0 and total_failures == 0,
+    }
+    proofs["5_dictionary_reported_excluded"] = {
+        "dictionary_handling_values": dict(handling_values),
+        "rows_with_nonzero_dictionary_count": dict_rows, "total_rows": total_rows,
+        "dictionary_count_sum": dict_sum,
+        "note": "counters are reported in the trace but never enter the cost formula "
+                "(proof 4 recomputes costs from the four gamma counters alone and matches)",
+        "pass": set(handling_values) == {"excluded_reported"} and dict_rows > 0,
+    }
+    proofs["6_counters_nonzero"] = {
+        "rows_with_at_least_2_nonzero_counters": counter_rows_ge2, "total_rows": total_rows,
+        "fraction": counter_rows_ge2 / total_rows if total_rows else 0.0,
+        "gamma_counter_totals": dict(gamma_totals),
+        "pass": counter_rows_ge2 > 0 and all(v > 0 for v in gamma_totals.values()),
+    }
+
+
+def proof_7(proofs: dict) -> None:
+    """Schedule replay determinism."""
+    names = ("smoke_our_full", "smoke_our_full_rerun", "smoke_our_full_block2")
+    plan_hash = {n: sha256_file(RUNS / n / "schedule_plan.csv") for n in names}
+    plans = {n: read_plan(RUNS / n / "schedule_plan.csv") for n in names}
+
+    def first_diff(a: str, b: str):
+        return next((i for i, (x, y) in enumerate(zip(plans[a], plans[b]))
+                     if (x["item_id"], x["item_name"]) != (y["item_id"], y["item_name"])), None)
+
+    manifests = {n: list(read_csv_rows(RUNS / n / "schedule_manifest.csv")) for n in names}
+
+    def prefix_len(a: str, b: str):
+        n = 0
+        for x, y in zip(manifests[a], manifests[b]):
+            if (x["submission_index"], x["item_id"], x["item_name"]) != \
+               (y["submission_index"], y["item_id"], y["item_name"]):
+                break
+            n += 1
+        return n
+
+    def manifest_matches_plan(n: str):
+        for x in manifests[n]:
+            p = plans[n][int(x["submission_index"])]
+            if x["item_id"] != p["item_id"]:
+                return False
+        return True
+
+    same_prefix = prefix_len("smoke_our_full", "smoke_our_full_rerun")
+    diff_prefix = prefix_len("smoke_our_full", "smoke_our_full_block2")
+    proofs["7_schedule_replay"] = {
+        "plan_sha256": plan_hash,
+        "same_seed_plans_identical": plan_hash["smoke_our_full"] == plan_hash["smoke_our_full_rerun"],
+        "same_seed_first_diverging_plan_row": first_diff("smoke_our_full", "smoke_our_full_rerun"),
+        "diff_seed_first_diverging_plan_row": first_diff("smoke_our_full", "smoke_our_full_block2"),
+        "manifest_lengths": {n: len(manifests[n]) for n in names},
+        "same_seed_manifest_common_prefix": same_prefix,
+        "diff_seed_manifest_common_prefix": diff_prefix,
+        "manifests_are_plan_prefixes": {n: manifest_matches_plan(n) for n in names},
+        "pass": (plan_hash["smoke_our_full"] == plan_hash["smoke_our_full_rerun"]
+                 and first_diff("smoke_our_full", "smoke_our_full_rerun") is None
+                 and first_diff("smoke_our_full", "smoke_our_full_block2") == 0
+                 and same_prefix == min(len(manifests["smoke_our_full"]),
+                                        len(manifests["smoke_our_full_rerun"]))
+                 and diff_prefix == 0
+                 and all(manifest_matches_plan(n) for n in names)),
+    }
+
+
+def proof_8(proofs: dict) -> None:
+    out = {}
+    for name in ("smoke_dram_only", "smoke_cxl_only"):
+        data = json.loads((RUNS / name / "numa_residency.json").read_text())
+        out[name] = {k: data.get(k) for k in
+                     ("target_node", "off_target_pct", "threshold_pct", "verdict", "total_pages")}
+    proofs["8_reference_residency"] = {
+        "predeclared_threshold_pct": 5.0, "bundles": out,
+        "pass": bool(out) and all(v.get("verdict") == "PASS" for v in out.values()),
+    }
+
+
+def proof_9(proofs: dict) -> None:
+    path = RUNS / "smoke_our_full_traceon" / "operator_segment_trace.csv"
+    levels = Counter()
+    measured_missing_reads = 0
+    nonmeasured_with_reads = 0
+    rows = 0
+    enum_ok = True
+    for row in read_csv_rows(path):
+        rows += 1
+        level = row["attribution_level"]
+        levels[level] += 1
+        if level not in ("measured_per_execution", "counter_delta_concurrent", "plan_reference_only"):
+            enum_ok = False
+        reads = row.get("actual_reads", "")
+        if level == "measured_per_execution" and reads == "":
+            measured_missing_reads += 1
+        if level != "measured_per_execution" and reads != "":
+            nonmeasured_with_reads += 1
+    proofs["9_operator_attribution"] = {
+        "rows": rows, "level_counts": dict(levels), "level_enum_ok": enum_ok,
+        "measured_rows_missing_actual_reads": measured_missing_reads,
+        "nonmeasured_rows_with_actual_reads": nonmeasured_with_reads,
+        "pass": rows > 0 and enum_ok and measured_missing_reads == 0 and nonmeasured_with_reads == 0,
+    }
+
+
+def proof_10(proofs: dict) -> None:
+    env = PHASE_B / "environment"
+    required = ["ENVIRONMENT.md", "numactl_H.txt", "lspci_cxl.txt", "cxl_device_detail.txt",
+                "platform_identity.txt", "lscpu.txt", "node2_distance.txt", "node2_meminfo.txt"]
+    missing = [f for f in required if not (env / f).is_file()]
+    numactl = (env / "numactl_H.txt").read_text()
+    device = (env / "cxl_device_detail.txt").read_text()
+    evidence = {
+        "node2_memory_only_no_cpus": "node 2 cpus:\n" in numactl and "node 2 size: 524288 MB" in numactl,
+        "cxl_pci_device_present": "1f16:c500" in device and "CXL Memory Device" in device,
+        "device_attached_to_numa_node_1": "NUMA node: 1" in device,
+    }
+    proofs["10_platform_identity"] = {
+        "required_files": required, "missing": missing, "evidence": evidence,
+        "pass": not missing and all(evidence.values()),
+    }
+
+
+def main() -> int:
+    proofs: dict = {}
+    for fn in (proof_1, proof_2_3, proof_4_5_6, proof_7, proof_8, proof_9, proof_10):
+        fn(proofs)
+    all_pass = all(v.get("pass", False) for v in proofs.values() if isinstance(v, dict))
+    proofs["ALL_PROOFS_PASS"] = all_pass
+    (PHASE_B / "PROOFS.json").write_text(json.dumps(proofs, indent=2, ensure_ascii=False) + "\n")
+    lines = ["# Phase B — ten proofs", "", f"**ALL_PROOFS_PASS = {all_pass}**", ""]
+    names = {"1_candidate_set": "1  candidate set identical across migration arms",
+             "2_strict_fit_budget": "2  strict-fit budget + deterministic tie-break",
+             "3_semantic_recompute": "3  semantic score recompute (1e-9)",
+             "4_c3_recompute": "4  C3 score recompute from counters + calibration",
+             "5_dictionary_reported_excluded": "5  dictionary counters reported, excluded",
+             "6_counters_nonzero": "6  ≥2 pattern counters non-zero",
+             "7_schedule_replay": "7  schedule replay determinism",
+             "8_reference_residency": "8  reference-arm NUMA residency (≤5% off-target)",
+             "9_operator_attribution": "9  operator attribution_level / null reads",
+             "10_platform_identity": "10 CXL device & platform identity evidence"}
+    for key, title in names.items():
+        p = proofs[key]
+        lines.append(f"## {title} — {'PASS' if p['pass'] else 'FAIL'}")
+        for k, v in p.items():
+            if k in ("description", "note", "formula", "tolerance"):
+                lines.append(f"- {k}: {v}")
+            elif isinstance(v, (dict, list)):
+                lines.append(f"- `{k}`: `{json.dumps(v, ensure_ascii=False)}`")
+            else:
+                lines.append(f"- `{k}`: `{v}`")
+        lines.append("")
+    (PHASE_B / "PROOFS.md").write_text("\n".join(lines))
+    print(json.dumps({k: v.get("pass") for k, v in proofs.items() if isinstance(v, dict)}, indent=2))
+    print(f"ALL_PROOFS_PASS={all_pass}")
+    return 0 if all_pass else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
