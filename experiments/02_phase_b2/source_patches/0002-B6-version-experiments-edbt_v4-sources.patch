@@ -0,0 +1,60 @@
+#!/bin/bash
+# EDBT v4 Phase B — commit B1 trace-off equivalence proof runner.
+# Proves (before any mapper change, commit B2):
+#   A) base(0f182ad07) vs B1, daemon OFF  -> placement CSV byte-identical,
+#      filtered run.log identical (deterministic decision path)
+#   B) base vs base, daemon ON (control)  -> placement CSV identical, but
+#      [Daemon] cycle lines differ run-to-run (pre-existing nondeterminism
+#      from Shuffled access interleaving, NOT caused by B1)
+#   C) base vs B1, daemon ON              -> placement CSV byte-identical
+#   D) B1 with --placement_trace          -> emitter works; rows honestly
+#      record the v3 mapper boundary overshoot (selected=true,
+#      fits_remaining=false) at this commit
+# All runs: numactl -N 1, JOB 113, Shuffled, clients 10, c05 budget
+# (3.47 GiB DRAM logical / 100 GiB CXL), demote_pct 0.95, dram_first, 45 s.
+set -uo pipefail
+ROOT=/home/dameng/CXL_migration/hyrise
+OUT="$ROOT/results_edbt_v4/01_phase_b/smoke_runs/commit_b1_equivalence"
+B1BIN="$ROOT/build/hyriseBenchmarkJoinOrder"
+B1PLUG="$ROOT/build/lib/libhyriseSemanticPlacementPlugin.so"
+# Clean full rebuild of the base commit 0f182ad07 in a separate worktree
+# (incremental revert-rebuild in the main tree produced a corrupt binary via
+# stale objects after the types.hpp layout change; that attempt is kept as
+# build_logs/build_base.log + a failure note, the binaries were discarded).
+BASEBIN="/home/dameng/CXL_migration/hyrise_base_wt/build_base/hyriseBenchmarkJoinOrder"
+BASEPLUG="/home/dameng/CXL_migration/hyrise_base_wt/build_base/lib/libhyriseSemanticPlacementPlugin.so"
+TIME_S=45
+mkdir -p "$OUT"
+
+run_one() { # run_one <name> <bin> <plugin> <extra args...>
+  local name=$1; shift
+  local bin=$1; shift
+  local plug=$1; shift
+  local d="$OUT/$name"
+  rm -rf "$d"; mkdir -p "$d"
+  local cmd=(numactl -N 1 "$bin" --table_path imdb_data --queries all
+             --mode Shuffled --time $TIME_S --clients 10 --scheduler --cores 0
+             --dont_cache_binary_tables --warmup 0
+             --plugins "$plug" --semantic --dram_first
+             --rmem_ids 2 --lmem_ids 1
+             --dram_capacity_gb 3.47 --cxl_capacity_gb 100.0 --demote_pct 0.95
+             -o "$d/benchmark.json" "$@")
+  echo "[RUN ] $name $(date -Is)" | tee -a "$OUT/EQ_PROGRESS.log"
+  echo "  cmd: ${cmd[*]}" >> "$OUT/EQ_PROGRESS.log"
+  ( cd "$ROOT" && "${cmd[@]}" > "$d/run.log" 2>&1 )
+  echo $? > "$d/exit_code.txt"
+  sha256sum "$bin" "$plug" > "$d/binary_hashes.txt"
+  echo "[DONE] $name exit=$(cat "$d/exit_code.txt") $(date -Is)" | tee -a "$OUT/EQ_PROGRESS.log"
+}
+
+# --- Pair A: deterministic decision path (daemon off) ---
+run_one eq_base_daemon0 "$BASEBIN" "$BASEPLUG" --daemon_period 0
+run_one eq_b1_daemon0   "$B1BIN"   "$B1PLUG"   --daemon_period 0
+# --- Control pair B + pair C: daemon on ---
+run_one eq_base_d1_run1 "$BASEBIN" "$BASEPLUG" --daemon_period 1
+run_one eq_base_d1_run2 "$BASEBIN" "$BASEPLUG" --daemon_period 1
+run_one eq_b1_d1        "$B1BIN"   "$B1PLUG"   --daemon_period 1
+# --- D: trace emitter smoke (B1, trace on) ---
+EDBT_V4_RUN_ID=trc_b1_d1 EDBT_V4_REP=1 run_one trc_b1_d1 "$B1BIN" "$B1PLUG" \
+    --daemon_period 1 --placement_trace
+echo "[ALL DONE] $(date -Is)" | tee -a "$OUT/EQ_PROGRESS.log"
diff --git a/experiments/edbt_v4/run_smoke_phase_b.py b/experiments/edbt_v4/run_smoke_phase_b.py
new file mode 100644
index 000000000..c79f4d6be
--- /dev/null
+++ b/experiments/edbt_v4/run_smoke_phase_b.py
@@ -0,0 +1,268 @@
+#!/usr/bin/env python3
+"""EDBT v4 Phase B smoke harness.
+
+Runs the five E12-style configurations (short --time) plus the E13-style trace
+run and the schedule-determinism probes, assembles validator-ready bundles and
+invokes scripts/validate_run_bundle.py on every bundle.
+
+Usage: python3 experiments/edbt_v4/run_smoke_phase_b.py [--time 120] [--only cfg,...]
+"""
+from __future__ import annotations
+
+import argparse
+import csv
+import json
+import math
+import os
+import shutil
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+ROOT = Path("/home/dameng/CXL_migration/hyrise")
+PACK = Path("/home/dameng/CXL_migration/edbt_phase_b_extract/CXL 页面迁移/edbt_experiment_pack")
+BIN = ROOT / "build/hyriseBenchmarkJoinOrder"
+PLUGIN = ROOT / "build/lib/libhyriseSemanticPlacementPlugin.so"
+VALIDATOR = PACK / "scripts/validate_run_bundle.py"
+OUTROOT = ROOT / "results_edbt_v4/01_phase_b/smoke_runs"
+
+# PHASE_B_GATE fix 8: one exact integer byte budget everywhere.
+# float32(3.47) * 2^30 truncated  ==  3725884160  (code semantics: GiB despite flag name)
+DRAM_BUDGET_BYTES = 3725884160
+CXL_GB = 100.0
+DEMOTE_PCT = 0.95
+
+COMMON = ["--table_path", "imdb_data", "--queries", "all", "--mode", "Shuffled",
+          "--clients", "10", "--scheduler", "--cores", "0", "--dont_cache_binary_tables",
+          "--warmup", "0"]
+
+# Predeclared BEFORE inspecting any residency result (requirement F / gate 6):
+# a reference arm is accepted for smoke if off-target pages <= 5% of total.
+OFF_TARGET_PAGE_THRESHOLD_PCT = 5.0
+
+MIGRATION_BASE = ["--plugins", str(PLUGIN), "--semantic", "--dram_first",
+                  "--rmem_ids", "2", "--lmem_ids", "1",
+                  "--dram_capacity_gb", "3.47", "--cxl_capacity_gb", str(CXL_GB),
+                  "--demote_pct", str(DEMOTE_PCT), "--daemon_period", "1"]
+
+
+def sha256(path: Path) -> str:
+    return subprocess.check_output(["sha256sum", str(path)], text=True).split()[0]
+
+
+def git_hash() -> str:
+    return subprocess.check_output(["git", "-C", str(ROOT), "rev-parse", "HEAD"], text=True).strip()
+
+
+def git_dirty() -> bool:
+    st = subprocess.check_output(["git", "-C", str(ROOT), "status", "--porcelain"], text=True)
+    return bool(st.strip())
+
+
+def git_tracked_dirty() -> bool:
+    """True only if tracked files are modified (ignores untracked output dirs)."""
+    st = subprocess.check_output(["git", "-C", str(ROOT), "status", "--porcelain"], text=True)
+    return any(line and not line.startswith("??") for line in st.splitlines())
+
+
+def sample_numa_maps(pid: int, out: Path) -> dict:
+    """Snapshot /proc/<pid>/numa_maps and aggregate pages per node."""
+    try:
+        text = Path(f"/proc/{pid}/numa_maps").read_text()
+    except OSError as exc:
+        return {"error": str(exc)}
+    out.write_text(text, encoding="utf-8")
+    per_node: dict[str, int] = {}
+    total = 0
+    for line in text.splitlines():
+        for token in line.split():
+            if token.startswith("N") and "=" in token:
+                node, _, value = token.partition("=")
+                try:
+                    pages = int(value)
+                except ValueError:
+                    continue
+                per_node[node] = per_node.get(node, 0) + pages
+                total += pages
+    off = {n: p for n, p in per_node.items() if n not in ("N0", "N1", "N2")}
+    return {"per_node_pages": per_node, "total_pages": total, "other_nodes": off}
+
+
+def summarize(benchmark_json: Path, run_dir: Path, config: str, rep: int) -> None:
+    data = json.loads(benchmark_json.read_text())
+    per_item: dict[str, list[float]] = {}
+    for b in data.get("benchmarks", []):
+        runs = [r["duration"] / 1e6 for r in b.get("successful_runs", [])]
+        per_item[b["name"]] = runs
+    items = sorted(per_item)
+    means = []
+    with (run_dir / "per_query.csv").open("w", newline="") as f:
+        w = csv.writer(f)
+        w.writerow(["item_name", "n_runs", "avg_ms"])
+        for name in items:
+            runs = per_item[name]
+            avg = sum(runs) / len(runs) if runs else float("nan")
+            means.append(avg)
+            w.writerow([name, len(runs), f"{avg:.6f}"])
+    geomean = math.exp(sum(math.log(m) for m in means) / len(means)) if means and all(m > 0 for m in means) else float("nan")
+    with (run_dir / "summary.csv").open("w", newline="") as f:
+        w = csv.writer(f)
+        w.writerow(["config", "rep", "n_items", "geomean_avg_ms"])
+        w.writerow([config, rep, len(items), f"{geomean:.6f}"])
+
+
+def run_bundle(name: str, config: str, rep: int, extra: list[str], membind: str | None,
+               trace: bool, time_s: int, schedule_seed: int | None) -> Path:
+    run_dir = OUTROOT / name
+    if run_dir.exists():
+        shutil.rmtree(run_dir)
+    run_dir.mkdir(parents=True)
+    bjson = run_dir / "benchmark.json"
+
+    cmd = ["numactl", "-N", "1"]
+    if membind:
+        cmd += ["-m", membind]
+    cmd += [str(BIN)] + COMMON + ["--time", str(time_s)]
+    if schedule_seed is not None:
+        cmd += ["--schedule_seed", str(schedule_seed)]
+    cmd += extra + ["-o", str(bjson)]
+
+    env = dict(os.environ)
+    if trace:
+        env["EDBT_V4_RUN_ID"] = name
+        env["EDBT_V4_REP"] = str(rep)
+        cmd += ["--placement_trace"]
+
+    cfg: dict = {
+        "config": config, "rep": rep, "experiment": "PHASE_B_SMOKE",
+        "git_hash": git_hash(), "git_dirty": git_dirty(),
+        "git_tracked_dirty": git_tracked_dirty(),
+        "binary_sha256": sha256(BIN), "command": " ".join(cmd),
+        "trace": trace, "time_s": time_s, "clients": 10,
+        "cpu_binding": "numactl -N 1", "dram_budget_bytes": None,
+        "off_target_page_threshold_pct": OFF_TARGET_PAGE_THRESHOLD_PCT,
+        "start_ts": time.strftime("%Y-%m-%dT%H:%M:%S"),
+    }
+    if config != "dram_only" and config != "cxl_only":
+        cfg["plugin_sha256"] = sha256(PLUGIN)
+        cfg["dram_budget_bytes"] = DRAM_BUDGET_BYTES
+        cfg["dram_capacity_gb_cli"] = 3.47
+        cfg["budget_note"] = ("float32(3.47)*2^30 truncated; code multiplies by SIZE_GIB "
+                              "(GiB semantics despite the _gb flag name)")
+        cfg["membind"] = "lmem=1 (plugin LinearNumaMemoryResource), rmem=2"
+    else:
+        cfg["membind"] = f"numactl -N 1 -m {membind} (strict MPOL_BIND, no fallback)"
+    if schedule_seed is not None:
+        cfg["schedule_seed"] = schedule_seed
+
+    print(f"[RUN ] {name} seed={schedule_seed} trace={trace}", flush=True)
+    logf = (run_dir / "run.log").open("w")
+    proc = subprocess.Popen(cmd, stdout=logf, stderr=subprocess.STDOUT, cwd=str(ROOT), env=env)
+    exit_code = None
+    numa_residency = None
+    if membind:
+        # Sample page residency during the timed phase: IMDB load ~15 s, so sample
+        # at half the timed duration (capped so short runs are still caught alive).
+        time.sleep(max(20, min(60, time_s // 2)))
+        for _ in range(20):
+            if proc.poll() is not None:
+                break
+            if Path(f"/proc/{proc.pid}/numa_maps").exists():
+                numa_residency = sample_numa_maps(proc.pid, run_dir / "numa_maps_sample.txt")
+                break
+            time.sleep(5)
+        else:
+            numa_residency = sample_numa_maps(proc.pid, run_dir / "numa_maps_sample.txt")
+    exit_code = proc.wait()
+    logf.close()
+    (run_dir / "exit_code.txt").write_text(f"{exit_code}\n")
+    print(f"[DONE] {name} exit={exit_code}", flush=True)
+
+    if numa_residency is not None:
+        (run_dir / "numa_residency.json").write_text(json.dumps(numa_residency, indent=2) + "\n")
+        if "per_node_pages" in numa_residency:
+            target = "N1" if membind == "1" else "N2"
+            total = numa_residency["total_pages"] or 1
+            off_pct = 100.0 * (total - numa_residency["per_node_pages"].get(target, 0)) / total
+            verdict = "PASS" if off_pct <= OFF_TARGET_PAGE_THRESHOLD_PCT else "FAIL"
+            print(f"[NUMA] {name}: off-target {off_pct:.3f}% (threshold {OFF_TARGET_PAGE_THRESHOLD_PCT}%) -> {verdict}", flush=True)
+            (run_dir / "numa_residency.json").write_text(json.dumps(
+                {**numa_residency, "target_node": target, "off_target_pct": off_pct,
+                 "threshold_pct": OFF_TARGET_PAGE_THRESHOLD_PCT, "verdict": verdict}, indent=2) + "\n")
+
+    if exit_code == 0 and bjson.exists():
+        summarize(bjson, run_dir, config, rep)
+        stem = str(bjson)[:-len(".json")]
+        # The benchmark writes its sidecars next to the JSON (which lives in
+        # run_dir), so most sources are already at their final location; copy
+        # only those that need renaming to the validator's canonical names.
+        for suffix, dest in (("_semantic_placement.csv", "benchmark_semantic_placement.csv"),
+                             ("_daemon_metrics.csv", "daemon_metrics.csv"),
+                             ("_decision_trace.csv", "decision_trace.csv"),
+                             ("_operator_segment_trace.csv", "operator_segment_trace.csv"),
+                             ("_schedule_plan.csv", "schedule_plan.csv"),
+                             ("_schedule_manifest.csv", "schedule_manifest.csv")):
+            src = Path(stem + suffix)
+            if src.exists() and src != run_dir / dest:
+                shutil.copy2(src, run_dir / dest)
+        if (run_dir / "schedule_plan.csv").exists():
+            cfg["query_schedule_sha256"] = sha256(run_dir / "schedule_plan.csv")
+
+    (run_dir / "run_config.json").write_text(json.dumps(cfg, indent=2) + "\n")
+
+    # Validator
+    vcmd = [sys.executable, str(VALIDATOR), str(run_dir)]
+    if trace:
+        vcmd += ["--require-trace", "--budget-bytes", str(DRAM_BUDGET_BYTES)]
+    elif config not in ("dram_only", "cxl_only"):
+        vcmd += ["--budget-bytes", str(DRAM_BUDGET_BYTES)]
+    vres = subprocess.run(vcmd, capture_output=True, text=True)
+    (run_dir / "validator_stdout.json").write_text(vres.stdout)
+    ok = vres.returncode == 0
+    print(f"[VALIDATE] {name}: {'OK' if ok else 'FAIL'}", flush=True)
+    return run_dir
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--time", type=int, default=120)
+    ap.add_argument("--only", type=str, default="")
+    args = ap.parse_args()
+    OUTROOT.mkdir(parents=True, exist_ok=True)
+    calib = ROOT / "results_edbt_v4/01_phase_b/calibration/calibration.csv"
+
+    seed = 101  # block 1 smoke schedule
+    plans = [
+        ("smoke_our_full", "our_full", 1, MIGRATION_BASE, None, False, seed),
+        ("smoke_our_freq", "our_freq", 1, MIGRATION_BASE + ["--ablate_d1"], None, False, seed),
+        ("smoke_cost_c3_greedy", "cost_c3_greedy", 1,
+         MIGRATION_BASE + ["--cost_c3_greedy", "--c3_calibration", str(calib)], None, False, seed),
+        ("smoke_dram_only", "dram_only", 1, [], "1", False, seed),
+        ("smoke_cxl_only", "cxl_only", 1, [], "2", False, seed),
+        ("smoke_our_full_traceon", "our_full", 1, MIGRATION_BASE, None, True, seed),
+        ("smoke_our_freq_traceon", "our_freq", 1, MIGRATION_BASE + ["--ablate_d1"], None, True, seed),
+        ("smoke_cost_c3_greedy_traceon", "cost_c3_greedy", 1,
+         MIGRATION_BASE + ["--cost_c3_greedy", "--c3_calibration", str(calib)], None, True, seed),
+        # Determinism probes (strict-fit mapper + schedule replay):
+        ("smoke_our_full_rerun", "our_full", 1, MIGRATION_BASE, None, False, seed),
+        ("smoke_our_full_block2", "our_full", 2, MIGRATION_BASE, None, False, 202),
+    ]
+    if args.only:
+        keep = set(args.only.split(","))
+        plans = [p for p in plans if p[0] in keep]
+    failures = []
+    for name, config, rep, extra, membind, trace, s in plans:
+        try:
+            run_bundle(name, config, rep, extra, membind, trace, args.time, s)
+        except Exception as exc:  # keep the matrix running; record the failure
+            import traceback
+            failures.append((name, repr(exc)))
+            print(f"[BUNDLE FAILED] {name}: {exc!r}", flush=True)
+            traceback.print_exc()
+    print(f"[ALL SMOKE DONE] failures={failures if failures else 'none'}")
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/experiments/edbt_v4/run_smoke_phase_b2.py b/experiments/edbt_v4/run_smoke_phase_b2.py
new file mode 100644
index 000000000..a858f17f2
--- /dev/null
+++ b/experiments/edbt_v4/run_smoke_phase_b2.py
@@ -0,0 +1,276 @@
+#!/usr/bin/env python3
+"""EDBT v4 Phase B2 smoke runner (B2-10).
+
+Re-runs the required smoke matrix on the B5 commit and invokes the phase_b2
+validator with --create-stamp (a stamp binds the validator's own SHA-256 and
+the validation report's SHA-256; never written after a failed check).
+
+B2 evidence bundles:
+  trace-on x3    -> initial==daemon candidate-set identity (B2-2), all-policy
+                    typed-counter tail columns (B2-4), dictionary share (B2-8)
+  measured x1    -> single-client measured diagnostic pass (B2-5)
+  trace-off x3   -> policy arms on the new binaries
+  reference x2   -> dram_only / cxl_only
+  rerun x1       -> same-seed determinism probe
+
+Every run_config.json records runner_sha256 (this file) and validator_sha256
+(B2-1). Output: results_edbt_v4/02_phase_b2/smoke_runs/.
+"""
+
+import argparse
+import csv
+import json
+import math
+import os
+import shutil
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+ROOT = Path("/home/dameng/CXL_migration/hyrise")
+PACK = Path("/home/dameng/CXL_migration/edbt_phase_b2_extract/CXL 页面迁移/edbt_experiment_pack")
+BIN = ROOT / "build/hyriseBenchmarkJoinOrder"
+PLUGIN = ROOT / "build/lib/libhyriseSemanticPlacementPlugin.so"
+VALIDATOR = PACK / "scripts/validate_run_bundle.py"
+OUTROOT = ROOT / "results_edbt_v4/02_phase_b2/smoke_runs"
+CALIB = ROOT / "results_edbt_v4/02_phase_b2/calibration/calibration.csv"
+
+DRAM_BUDGET_BYTES = 3725884160
+CXL_GB = 100.0
+DEMOTE_PCT = 0.95
+OFF_TARGET_PAGE_THRESHOLD_PCT = 5.0
+
+COMMON = ["--table_path", "imdb_data", "--queries", "all", "--mode", "Shuffled",
+          "--clients", "10", "--scheduler", "--cores", "0", "--dont_cache_binary_tables",
+          "--warmup", "0"]
+
+MIGRATION_BASE = ["--plugins", str(PLUGIN), "--semantic", "--dram_first",
+                  "--rmem_ids", "2", "--lmem_ids", "1",
+                  "--dram_capacity_gb", "3.47", "--cxl_capacity_gb", str(CXL_GB),
+                  "--demote_pct", str(DEMOTE_PCT), "--daemon_period", "1"]
+
+
+def sha256(path: Path) -> str:
+    return subprocess.check_output(["sha256sum", str(path)], text=True).split()[0]
+
+
+def git_hash() -> str:
+    return subprocess.check_output(["git", "-C", str(ROOT), "rev-parse", "HEAD"], text=True).strip()
+
+
+def git_tracked_dirty() -> bool:
+    st = subprocess.check_output(["git", "-C", str(ROOT), "status", "--porcelain"], text=True)
+    return any(line and not line.startswith("??") for line in st.splitlines())
+
+
+def sample_numa_maps(pid: int, out: Path) -> dict:
+    try:
+        text = Path(f"/proc/{pid}/numa_maps").read_text()
+    except OSError as exc:
+        return {"error": str(exc)}
+    out.write_text(text, encoding="utf-8")
+    per_node: dict[str, int] = {}
+    total = 0
+    for line in text.splitlines():
+        for token in line.split():
+            if token.startswith("N") and "=" in token:
+                node, _, value = token.partition("=")
+                try:
+                    pages = int(value)
+                except ValueError:
+                    continue
+                per_node[node] = per_node.get(node, 0) + pages
+                total += pages
+    off = {n: p for n, p in per_node.items() if n not in ("N0", "N1", "N2")}
+    return {"per_node_pages": per_node, "total_pages": total, "other_nodes": off}
+
+
+def summarize(benchmark_json: Path, run_dir: Path, config: str, rep: int) -> None:
+    data = json.loads(benchmark_json.read_text())
+    per_item: dict[str, list[float]] = {}
+    for b in data.get("benchmarks", []):
+        runs = [r["duration"] / 1e6 for r in b.get("successful_runs", [])]
+        per_item[b["name"]] = runs
+    items = sorted(per_item)
+    means = []
+    with (run_dir / "per_query.csv").open("w", newline="") as f:
+        w = csv.writer(f)
+        w.writerow(["item_name", "n_runs", "avg_ms"])
+        for name in items:
+            runs = per_item[name]
+            avg = sum(runs) / len(runs) if runs else float("nan")
+            means.append(avg)
+            w.writerow([name, len(runs), f"{avg:.6f}"])
+    geomean = math.exp(sum(math.log(m) for m in means) / len(means)) if means and all(m > 0 for m in means) else float("nan")
+    with (run_dir / "summary.csv").open("w", newline="") as f:
+        w = csv.writer(f)
+        w.writerow(["config", "rep", "n_items", "geomean_avg_ms"])
+        w.writerow([config, rep, len(items), f"{geomean:.6f}"])
+
+
+def run_bundle(name: str, config: str, rep: int, extra: list[str], membind: str | None,
+               trace: bool, time_s: int, schedule_seed: int | None,
+               measured: bool = False, clients: int = 10) -> Path:
+    run_dir = OUTROOT / name
+    if run_dir.exists():
+        shutil.rmtree(run_dir)
+    run_dir.mkdir(parents=True)
+    bjson = run_dir / "benchmark.json"
+
+    common = list(COMMON)
+    common[common.index("--clients") + 1] = str(clients)
+    cmd = ["numactl", "-N", "1"]
+    if membind:
+        cmd += ["-m", membind]
+    cmd += [str(BIN)] + common + ["--time", str(time_s)]
+    if schedule_seed is not None:
+        cmd += ["--schedule_seed", str(schedule_seed)]
+    cmd += extra
+    if trace:
+        cmd += ["--placement_trace"]
+    if measured:
+        cmd += ["--placement_trace_measured"]
+    cmd += ["-o", str(bjson)]
+
+    env = dict(os.environ)
+    if trace:
+        env["EDBT_V4_RUN_ID"] = name
+        env["EDBT_V4_REP"] = str(rep)
+
+    cfg: dict = {
+        "config": config, "rep": rep, "experiment": "PHASE_B2_SMOKE",
+        "git_hash": git_hash(), "git_tracked_dirty": git_tracked_dirty(),
+        "runner": str(Path(__file__).resolve()),
+        "runner_sha256": sha256(Path(__file__).resolve()),
+        "validator": str(VALIDATOR), "validator_sha256": sha256(VALIDATOR),
+        "binary_sha256": sha256(BIN), "command": " ".join(cmd),
+        "trace": trace, "trace_measured": measured, "time_s": time_s, "clients": clients,
+        "cpu_binding": "numactl -N 1", "dram_budget_bytes": None,
+        "off_target_page_threshold_pct": OFF_TARGET_PAGE_THRESHOLD_PCT,
+        "start_ts": time.strftime("%Y-%m-%dT%H:%M:%S"),
+    }
+    if config != "dram_only" and config != "cxl_only":
+        cfg["plugin_sha256"] = sha256(PLUGIN)
+        cfg["dram_budget_bytes"] = DRAM_BUDGET_BYTES
+        cfg["dram_capacity_gb_cli"] = 3.47
+        cfg["budget_note"] = ("float32(3.47)*2^30 truncated; code multiplies by SIZE_GIB "
+                              "(GiB semantics despite the _gb flag name)")
+        cfg["membind"] = "lmem=1 (plugin LinearNumaMemoryResource), rmem=2"
+    else:
+        cfg["membind"] = f"numactl -N 1 -m {membind} (strict MPOL_BIND, no fallback)"
+    if config == "cost_c3_greedy":
+        cfg["c3_calibration"] = str(CALIB)
+        cfg["c3_calibration_sha256"] = sha256(CALIB)
+    if schedule_seed is not None:
+        cfg["schedule_seed"] = schedule_seed
+
+    print(f"[RUN ] {name} seed={schedule_seed} trace={trace} measured={measured} clients={clients}", flush=True)
+    logf = (run_dir / "run.log").open("w")
+    proc = subprocess.Popen(cmd, stdout=logf, stderr=subprocess.STDOUT, cwd=str(ROOT), env=env)
+    exit_code = None
+    numa_residency = None
+    if membind:
+        time.sleep(max(20, min(60, time_s // 2)))
+        for _ in range(20):
+            if proc.poll() is not None:
+                break
+            if Path(f"/proc/{proc.pid}/numa_maps").exists():
+                numa_residency = sample_numa_maps(proc.pid, run_dir / "numa_maps_sample.txt")
+                break
+            time.sleep(5)
+        else:
+            numa_residency = sample_numa_maps(proc.pid, run_dir / "numa_maps_sample.txt")
+    exit_code = proc.wait()
+    logf.close()
+    (run_dir / "exit_code.txt").write_text(f"{exit_code}\n")
+    print(f"[DONE] {name} exit={exit_code}", flush=True)
+
+    if numa_residency is not None and "per_node_pages" in numa_residency:
+        target = "N1" if membind == "1" else "N2"
+        total = numa_residency["total_pages"] or 1
+        off_pct = 100.0 * (total - numa_residency["per_node_pages"].get(target, 0)) / total
+        verdict = "PASS" if off_pct <= OFF_TARGET_PAGE_THRESHOLD_PCT else "FAIL"
+        print(f"[NUMA] {name}: off-target {off_pct:.3f}% -> {verdict}", flush=True)
+        numa_residency.update(target_node=target, off_target_pct=off_pct,
+                              threshold_pct=OFF_TARGET_PAGE_THRESHOLD_PCT, verdict=verdict)
+    if numa_residency is not None:
+        (run_dir / "numa_residency.json").write_text(json.dumps(numa_residency, indent=2) + "\n")
+
+    if exit_code == 0 and bjson.exists():
+        summarize(bjson, run_dir, config, rep)
+        stem = str(bjson)[:-len(".json")]
+        for suffix, dest in (("_semantic_placement.csv", "benchmark_semantic_placement.csv"),
+                             ("_daemon_metrics.csv", "daemon_metrics.csv"),
+                             ("_decision_trace.csv", "decision_trace.csv"),
+                             ("_operator_segment_trace.csv", "operator_segment_trace.csv"),
+                             ("_measured_segment_access.csv", "measured_segment_access.csv"),
+                             ("_schedule_plan.csv", "schedule_plan.csv"),
+                             ("_schedule_manifest.csv", "schedule_manifest.csv")):
+            src = Path(stem + suffix)
+            if src.exists() and src != run_dir / dest:
+                shutil.copy2(src, run_dir / dest)
+        if (run_dir / "schedule_plan.csv").exists():
+            cfg["query_schedule_sha256"] = sha256(run_dir / "schedule_plan.csv")
+
+    (run_dir / "run_config.json").write_text(json.dumps(cfg, indent=2) + "\n")
+
+    # Validator with stamp creation (B2-10): a stamp is written only when all
+    # checks pass and binds the validator SHA-256 + validation-report SHA-256.
+    vcmd = [sys.executable, str(VALIDATOR), str(run_dir), "--create-stamp"]
+    if trace:
+        vcmd += ["--require-trace", "--budget-bytes", str(DRAM_BUDGET_BYTES)]
+    elif config not in ("dram_only", "cxl_only"):
+        vcmd += ["--budget-bytes", str(DRAM_BUDGET_BYTES)]
+    vres = subprocess.run(vcmd, capture_output=True, text=True)
+    (run_dir / "validator_stdout.json").write_text(vres.stdout)
+    ok = vres.returncode == 0
+    stamped = (run_dir / "validated.ok").exists()
+    print(f"[VALIDATE] {name}: {'OK' if ok else 'FAIL'} stamped={stamped}", flush=True)
+    return run_dir
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--time", type=int, default=120)
+    ap.add_argument("--only", type=str, default="")
+    args = ap.parse_args()
+    OUTROOT.mkdir(parents=True, exist_ok=True)
+
+    seed = 101  # block 1 smoke schedule (same as Phase B for comparability)
+    plans = [
+        ("smoke_b2_our_full", "our_full", 1, MIGRATION_BASE, None, False, seed, dict()),
+        ("smoke_b2_our_freq", "our_freq", 1, MIGRATION_BASE + ["--ablate_d1"], None, False, seed, dict()),
+        ("smoke_b2_cost_c3_greedy", "cost_c3_greedy", 1,
+         MIGRATION_BASE + ["--cost_c3_greedy", "--c3_calibration", str(CALIB)], None, False, seed, dict()),
+        ("smoke_b2_dram_only", "dram_only", 1, [], "1", False, seed, dict()),
+        ("smoke_b2_cxl_only", "cxl_only", 1, [], "2", False, seed, dict()),
+        ("smoke_b2_our_full_traceon", "our_full", 1, MIGRATION_BASE, None, True, seed, dict()),
+        ("smoke_b2_our_freq_traceon", "our_freq", 1, MIGRATION_BASE + ["--ablate_d1"], None, True, seed, dict()),
+        ("smoke_b2_cost_c3_greedy_traceon", "cost_c3_greedy", 1,
+         MIGRATION_BASE + ["--cost_c3_greedy", "--c3_calibration", str(CALIB)], None, True, seed, dict()),
+        # B2-5 single-client measured diagnostic (trace + measured, clients=1)
+        ("smoke_b2_our_full_measured", "our_full", 1, MIGRATION_BASE, None, True, seed,
+         dict(measured=True, clients=1, time_s=60)),
+        # Determinism probes (strict-fit mapper + schedule replay)
+        ("smoke_b2_our_full_rerun", "our_full", 1, MIGRATION_BASE, None, False, seed, dict()),
+    ]
+    if args.only:
+        keep = set(args.only.split(","))
+        plans = [p for p in plans if p[0] in keep]
+    failures = []
+    for name, config, rep, extra, membind, trace, s, kw in plans:
+        time_s = kw.pop("time_s", args.time)
+        try:
+            run_bundle(name, config, rep, extra, membind, trace, time_s, s, **kw)
+        except Exception as exc:  # keep the matrix running; record the failure
+            import traceback
+            failures.append((name, repr(exc)))
+            print(f"[BUNDLE FAILED] {name}: {exc!r}", flush=True)
+            traceback.print_exc()
+    print(f"[ALL B2 SMOKE DONE] failures={failures if failures else 'none'}")
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/experiments/edbt_v4/validate_run_bundle.py b/experiments/edbt_v4/validate_run_bundle.py
new file mode 100644
index 000000000..d157f853e
--- /dev/null
+++ b/experiments/edbt_v4/validate_run_bundle.py
@@ -0,0 +1,364 @@
+#!/usr/bin/env python3
+"""Validate one EDBT experiment run before it enters the analysis set."""
+
+from __future__ import annotations
+
+import argparse
+import csv
+import hashlib
+import json
+import math
+import sys
+from pathlib import Path
+
+
+BASE_FILES = (
+    "run_config.json",
+    "run.log",
+    "exit_code.txt",
+    "benchmark.json",
+    "summary.csv",
+    "per_query.csv",
+)
+MIGRATION_FILES = ("benchmark_semantic_placement.csv", "daemon_metrics.csv")
+REFERENCE_CONFIGS = {"dram_only", "cxl_only", "no_place"}
+TRACE_FILES = ("decision_trace.csv", "operator_segment_trace.csv")
+TRACE_REQUIRED = {
+    "decision_trace.csv": {
+        "run_id", "config", "rep", "unix_ts_ns", "cycle_id", "phase",
+        "table_name", "chunk_id", "column_id", "segment_bytes",
+        "source_tier", "target_tier", "action", "selected", "rank",
+        "fits_remaining", "policy", "data_type", "bytes_per_value",
+        "total_score", "access_rate_raw", "max_rate", "norm_freq",
+        "access_type", "atype_score", "data_volume_bytes", "max_volume_bytes",
+        "norm_volume", "is_immutable", "immutable_score", "weight_atype",
+        "weight_freq", "weight_volume", "weight_immutable", "term_atype",
+        "term_freq", "term_volume", "term_immutable", "estimated_cardinality",
+        "operator_mask", "remaining_budget_before", "remaining_budget_after",
+    },
+    "operator_segment_trace.csv": {
+        "run_id", "config", "rep", "query_name", "execution_id",
+        "operator_id", "operator_type", "table_name", "chunk_id",
+        "column_id", "estimated_rows", "rows_in", "rows_out",
+        "operator_wall_ns", "actual_reads", "tier_at_execution", "attribution_level",
+    },
+}
+
+
+def add_error(report: dict, message: str) -> None:
+    report["errors"].append(message)
+
+
+def add_warning(report: dict, message: str) -> None:
+    report["warnings"].append(message)
+
+
+def parse_bool(value: str) -> bool:
+    normalized = value.strip().lower()
+    if normalized in {"true", "1", "yes"}:
+        return True
+    if normalized in {"false", "0", "no"}:
+        return False
+    raise ValueError(f"invalid boolean: {value!r}")
+
+
+def parse_number(row: dict, field: str, *, integer: bool = False) -> float | int:
+    value = row.get(field, "")
+    if value == "":
+        raise ValueError(f"empty numeric field {field}")
+    return int(value) if integer else float(value)
+
+
+def read_csv(path: Path) -> tuple[list[str], list[dict[str, str]]]:
+    with path.open(newline="", encoding="utf-8") as handle:
+        reader = csv.DictReader(handle)
+        return list(reader.fieldnames or []), list(reader)
+
+
+def validate_identity(config: dict, report: dict) -> None:
+    config_name = str(config.get("config", config.get("configuration", "")))
+    reference_only = config_name in REFERENCE_CONFIGS
+    aliases = {
+        "git revision": ("git_hash", "git_commit", "git_revision"),
+        "binary SHA-256": ("binary_sha256", "hyrise_binary_sha256"),
+        "command": ("command", "full_command"),
+        "configuration": ("config", "configuration"),
+        "repetition": ("rep", "repetition", "repetition_id"),
+        "query schedule SHA-256": ("query_schedule_sha256", "schedule_sha256", "query_order_sha256"),
+        "query schedule SHA-256": ("query_schedule_sha256", "schedule_sha256", "query_order_sha256"),
+    }
+    if not reference_only:
+        aliases["plugin SHA-256"] = ("plugin_sha256", "plugin_binary_sha256")
+        aliases["exact logical DRAM budget bytes"] = ("dram_budget_bytes", "dram_capacity_bytes")
+    for label, keys in aliases.items():
+        if not any(config.get(key) not in (None, "") for key in keys):
+            add_error(report, f"run_config.json lacks {label} ({', '.join(keys)})")
+
+    for key in ("binary_sha256", "hyrise_binary_sha256", "plugin_sha256", "plugin_binary_sha256", "query_schedule_sha256", "schedule_sha256", "query_order_sha256"):
+        value = config.get(key)
+        if value and (len(str(value)) != 64 or any(c not in "0123456789abcdefABCDEF" for c in str(value))):
+            add_error(report, f"{key} is not a 64-character SHA-256 digest")
+
+
+def validate_summary(run_dir: Path, report: dict) -> None:
+    try:
+        header, rows = read_csv(run_dir / "summary.csv")
+    except Exception as exc:
+        add_error(report, f"cannot parse summary.csv: {exc}")
+        return
+    if not rows:
+        add_error(report, "summary.csv has no data row")
+        return
+    candidate_metrics = {"geomean_avg_ms", "geomean_ms", "throughput_qps"}
+    if not candidate_metrics.intersection(header):
+        add_error(report, "summary.csv lacks geomean_avg_ms/geomean_ms/throughput_qps")
+    for metric in candidate_metrics.intersection(header):
+        try:
+            value = float(rows[0][metric])
+            if not math.isfinite(value) or value <= 0:
+                add_error(report, f"summary metric {metric} must be finite and positive")
+        except Exception as exc:
+            add_error(report, f"invalid summary metric {metric}: {exc}")
+
+
+def validate_daemon_metrics(run_dir: Path, report: dict) -> None:
+    required = {
+        "unix_ts", "cycle_id", "hit_rate_pct", "promotes", "demotes",
+        "bytes_promoted", "bytes_demoted", "daemon_cpu_ms", "replica_bytes",
+    }
+    try:
+        header, rows = read_csv(run_dir / "daemon_metrics.csv")
+    except Exception as exc:
+        add_error(report, f"cannot parse daemon_metrics.csv: {exc}")
+        return
+    missing = sorted(required - set(header))
+    if missing:
+        add_error(report, f"daemon_metrics.csv missing fields: {', '.join(missing)}")
+        return
+    if not rows:
+        add_error(report, "daemon_metrics.csv has no data rows")
+        return
+    previous_cycle = -1
+    previous_ts = -math.inf
+    for index, row in enumerate(rows, start=2):
+        try:
+            cycle = parse_number(row, "cycle_id", integer=True)
+            timestamp = parse_number(row, "unix_ts")
+            hit_rate = parse_number(row, "hit_rate_pct")
+            for field in ("promotes", "demotes", "bytes_promoted", "bytes_demoted", "daemon_cpu_ms", "replica_bytes"):
+                if parse_number(row, field) < 0:
+                    raise ValueError(f"{field} is negative")
+            if not 0 <= hit_rate <= 100:
+                raise ValueError("hit_rate_pct outside [0,100]")
+            if cycle < previous_cycle or timestamp < previous_ts:
+                raise ValueError("cycle_id or unix_ts decreases")
+            previous_cycle, previous_ts = cycle, timestamp
+        except Exception as exc:
+            add_error(report, f"daemon_metrics.csv row {index}: {exc}")
+            if len(report["errors"]) >= 25:
+                break
+
+
+def validate_trace(run_dir: Path, report: dict, budget_bytes: int | None) -> None:
+    for filename in TRACE_FILES:
+        path = run_dir / filename
+        if not path.exists():
+            add_error(report, f"required trace file missing: {filename}")
+            continue
+        try:
+            handle = path.open(newline="", encoding="utf-8")
+        except Exception as exc:
+            add_error(report, f"cannot open {filename}: {exc}")
+            continue
+        with handle:
+            reader = csv.DictReader(handle)
+            missing = sorted(TRACE_REQUIRED[filename] - set(reader.fieldnames or []))
+            if missing:
+                add_error(report, f"{filename} missing fields: {', '.join(missing)}")
+                continue
+            row_count = 0
+            selected_bytes_by_cycle: dict[tuple[str, str], int] = {}
+            for index, row in enumerate(reader, start=2):
+                row_count += 1
+                try:
+                    if filename == "operator_segment_trace.csv":
+                        level = row["attribution_level"]
+                        if level not in {"measured_per_execution", "counter_delta_concurrent", "plan_reference_only"}:
+                            raise ValueError(f"unknown attribution_level {level!r}")
+                        actual_reads = row.get("actual_reads", "")
+                        if level == "measured_per_execution" and actual_reads == "":
+                            raise ValueError("measured_per_execution requires actual_reads")
+                        if actual_reads != "" and int(actual_reads) < 0:
+                            raise ValueError("actual_reads is negative")
+                        if level == "plan_reference_only" and any(row.get(field, "") not in ("", None) for field in ("dram_accesses", "cxl_accesses", "dram_bytes", "cxl_bytes")):
+                            raise ValueError("plan_reference_only must not carry measured traffic fields")
+                        continue
+
+                    config = row["config"]
+                    if config not in {"our_full", "our_freq", "cost_c3_greedy"}:
+                        raise ValueError(f"unknown config {config!r}")
+                    selected = parse_bool(row["selected"])
+                    fits_remaining = parse_bool(row["fits_remaining"])
+                    parse_bool(row["is_immutable"])
+                    segment_bytes = parse_number(row, "segment_bytes", integer=True)
+                    before = parse_number(row, "remaining_budget_before", integer=True)
+                    after = parse_number(row, "remaining_budget_after", integer=True)
+                    for value, label in ((segment_bytes, "segment_bytes"), (before, "remaining_budget_before"), (after, "remaining_budget_after")):
+                        if value < 0:
+                            raise ValueError(f"{label} is negative")
+                    if budget_bytes is not None and max(before, after) > budget_bytes:
+                        raise ValueError("remaining budget exceeds declared byte budget")
+                    total = parse_number(row, "total_score")
+                    if not math.isfinite(float(total)):
+                        raise ValueError("total_score is not finite")
+                    expected_policy = {"our_full": "our_full", "our_freq": "our_no_plan", "cost_c3_greedy": "cost_c3_greedy"}[config]
+                    if row["policy"] != expected_policy:
+                        raise ValueError(f"policy {row['policy']!r} does not match config {config!r}")
+                    for field in ("norm_freq", "norm_volume"):
+                        value = float(row[field])
+                        if not 0.0 <= value <= 1.0:
+                            raise ValueError(f"{field} outside [0,1]")
+                    if selected and row["target_tier"] == "DRAM":
+                        if not fits_remaining or segment_bytes > before:
+                            raise ValueError("selected DRAM segment does not strictly fit remaining budget")
+                        if after != before - segment_bytes:
+                            raise ValueError("remaining budget does not decrease by selected segment bytes")
+                        cycle_key = (row["run_id"], row["cycle_id"])
+                        selected_bytes_by_cycle[cycle_key] = selected_bytes_by_cycle.get(cycle_key, 0) + int(segment_bytes)
+                    if row["action"] == "skip_no_fit" and (selected or fits_remaining):
+                        raise ValueError("skip_no_fit row must be unselected with fits_remaining=false")
+                    if config == "cost_c3_greedy":
+                        for field in ("sequential_count", "monotonic_count", "random_count", "point_count", "dictionary_count", "cost_dram", "cost_cxl"):
+                            if row.get(field, "") == "":
+                                raise ValueError(f"cost_c3_greedy lacks {field}")
+                        if not row.get("dictionary_handling", "").strip():
+                            raise ValueError("cost_c3_greedy lacks explicit dictionary_handling")
+                        expected = float(row["cost_cxl"]) - float(row["cost_dram"])
+                        if not math.isclose(float(total), expected, rel_tol=1e-6, abs_tol=1e-9):
+                            raise ValueError("total_score != cost_cxl - cost_dram")
+                    else:
+                        components = (
+                            ("weight_atype", "atype_score", "term_atype"),
+                            ("weight_freq", "norm_freq", "term_freq"),
+                            ("weight_volume", "norm_volume", "term_volume"),
+                            ("weight_immutable", "immutable_score", "term_immutable"),
+                        )
+                        terms = []
+                        for weight, feature, term in components:
+                            expected_term = float(row[weight]) * float(row[feature])
+                            actual_term = float(row[term])
+                            if not math.isclose(actual_term, expected_term, rel_tol=1e-9, abs_tol=1e-12):
